27\u0632 \u0686\u0646\u062f \u06a9\u0627\u0631\u062a \u0628\u0627\u0646\u06a9\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0631\u062f\u0647 \u0628\u0627\u0634\u062f \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u062f\u0631 \u0628\u0631\u0631\u0633\u06cc \u062f\u0642\u06cc\u0642 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0648\u0627\u0631\u06cc\u0632\u06cc \u062f\u0642\u062a \u06a9\u0646\u06cc\u062f.",INFORMATION_DISCREPANCY:"\u062f\u0631 \u0635\u0648\u0631\u062a \u0647\u0631 \u06af\u0648\u0646\u0647 \u0645\u063a\u0627\u06cc\u0631\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0641\u0631\u0648\u0634\u0646\u062f\u0647\u060c \u0627\u0631\u0632 \u062e\u0648\u062f \u0631\u0627 \u0622\u0632\u0627\u062f \u0646\u06a9\u0646\u06cc\u062f \u0648 \u062f\u06a9\u0645\u0647 \xab\u0639\u062f\u0645 \u0635\u062d\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a\xbb \u0631\u0627 \u0628\u0632\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0627\u0634\u062a\u0628\u0627\u0647\u060c \u0647\u06cc\u0686 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646 \u0648\u062c\u0647 \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0634\u0645\u0627 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.",IMPORTANT_INFORMATION:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0633\u0627\u0633 \u0628\u0627\u0646\u06a9\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0646\u06af\u0630\u0627\u0631\u06cc\u062f \u062a\u0627 \u0627\u0641\u0631\u0627\u062f \u0627\u0632 \u0622\u0646 \u0633\u0648\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0646\u0646\u062f.",TRANSFORM_THROUGH_CHANNEL:"\u0634\u0645\u0627 \u0647\u06cc\u0686 \u0648\u0642\u062a \u0646\u0628\u0627\u06cc\u062f \u0628\u0627 \u0647\u06cc\u0686 \u0641\u0631\u0645 \u062c\u0627 \u0628\u0647 \u062c\u0627\u06cc\u06cc \u067e\u0648\u0644 \u06a9\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u06a9\u0627\u0646\u0627\u0644 \u062b\u0627\u0644\u062b\u06cc \u0647\u0645\u0686\u0648\u0646 \u0634\u0628\u06a9\u0647 \u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u06cc\u0627 \u067e\u06cc\u0627\u0645\u0631\u0633\u0627\u0646 \u0647\u0627 \u0648 \u06cc\u0627 \u0645\u0639\u0627\u0645\u0644\u0647 \u0631\u0648 \u062f\u0631 \u0631\u0648\u060c \u0645\u0639\u0627\u0645\u0644\u0647 \u0627\u06cc \u0627\u0646\u062c\u0627\u0645 \u0647\u06cc\u062f. \u067e\u0644\u062a\u0641\u0631\u0645 \u0646\u0645\u06cc \u062a\u0648\u0627\u0646\u062f \u0645\u0633\u0626\u0648\u0644 \u062e\u0633\u0627\u0631\u062a \u0648 \u06cc\u0627 \u0636\u0631\u0631\u06cc \u0628\u0627\u0634\u062f \u06a9\u0647 \u062e\u0627\u0631\u062c \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u067e\u0644\u062a\u0641\u0631\u0645 \u062f\u0631 \u0647\u06cc\u0686 \u0628\u062e\u0634\u06cc \u0627\u0632 \u062c\u0627 \u0628\u0647 \u062c\u0627\u06cc\u06cc P2P \u062f\u062e\u0627\u0644\u062a\u06cc \u0646\u062f\u0627\u0631\u062f.",PAYMENT_SPECIFIED_TIME:"\u0644\u0637\u0641\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0632\u0645\u0627\u0646 \u0645\u0634\u062e\u0635 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f \u0648 \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u062f \u062f\u06a9\u0645\u0647 \xab \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u060c \u0628\u0639\u062f\u06cc \xbb \u0631\u0627 \u0628\u0632\u0646\u06cc\u062f. \u0628\u0639\u062f \u0627\u0632 \u0627\u06cc\u0646\u06a9\u0647 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u062a\u0627\u06cc\u06cc\u062f \u06a9\u0631\u062f \u060c \u0633\u06cc\u0633\u062a\u0645 \u062f\u0627\u0631\u0627\u06cc\u06cc \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0631\u0627 \u0628\u0647 \u0627\u06a9\u0627\u0646\u062a \u0634\u0645\u0627 \u0645\u0646\u062a\u0642\u0644 \u0645\u06cc\u06a9\u0646\u062f.",POSSIBLE_MULTIPLE_CARD:"\u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0627\u0632 \u0637\u0631\u06cc\u0642 \u06a9\u0627\u0631\u062a \u0628\u0647 \u06a9\u0627\u0631\u062a \u060c \u0627\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f \u06a9\u0647 \u0627\u0632 \u0686\u0646\u062f \u06a9\u0627\u0631\u062a \u0628\u0627\u0646\u06a9\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.",DEPOSIT_FROM_ACCOUNT:"\u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u062d\u062a\u0645\u0627 \u0648 \u0627\u06a9\u06cc\u062f\u0627 \u0627\u0632 \u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u062e\u0648\u062f \u067e\u0648\u0644  \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0647\u0631\u06af\u0648\u0646\u0647 \u0645\u063a\u0627\u06cc\u0631\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc\u060c \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0627\u0631\u0632  \u062e\u0648\u062f \u0631\u0627 \u0622\u0632\u0627\u062f \u0646\u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f \u0648 \u0647\u06cc\u0686 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631\u0628\u0631\u0627\u0628\u0631 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646 \u0648\u062c\u0647 \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0634\u0645\u0627 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.",DEPOSIT_AMOUNT_CORRECTLY:"\u0647\u0646\u06af\u0627\u0645 \u0648\u0627\u0631\u06cc\u0632 \u067e\u0648\u0644 \u0645\u0631\u0627\u0642\u0628 \u0628\u0627\u0634\u062f \u0645\u0628\u0644\u063a \u0631\u0627 \u062f\u0631\u0633\u062a \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u06a9\u0645 \u0628\u0648\u062f\u0646 \u0645\u0628\u0644\u063a \u0648\u0627\u0631\u06cc\u0632\u06cc \u060c \u067e\u0644\u062a\u0641\u0631\u0645  \u0645\u0639\u0627\u062f\u0644 \u0645\u0628\u0644\u063a \u0648\u0627\u0631\u06cc\u0632\u06cc \u0634\u0645\u0627 \u060c \u0627\u0631\u0632 \u0628\u0647  \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0648\u0627\u0631\u06cc\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0647\u0645\u0646\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0635\u0648\u0631\u062a \u0648\u0627\u0631\u06cc\u0632 \u0628\u06cc\u0634 \u0627\u0632 \u0645\u0628\u0644\u063a \u062a\u0639\u06cc\u06cc\u0646 \u0634\u062f\u0647 \u060c \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f \u0628\u0627 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u06af\u0641\u062a\u06af\u0648 \u06a9\u0646\u06cc\u062f \u0648 \u0645\u0634\u06a9\u0644 \u062e\u0648\u062f \u0631\u0627 \u062d\u0644 \u06a9\u0646\u06cc\u062f. \u067e\u0644\u062a\u0641\u0631\u0645 \u062f\u0631 \u0627\u06cc\u0646 \u0632\u0645\u06cc\u0646\u0647 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.",AFTER_EACH_PAYMENT:"\u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0628\u0639\u062f \u0627\u0632 \u0647\u0631 \u067e\u0631\u062f\u0627\u062e\u062a \u060c\u0634\u0645\u0627\u0631\u0647 \u06a9\u0627\u0631\u062a \u060c \u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc ( \u0627\u0631\u062c\u0627\u0639 ) \u0648 \u0645\u0628\u0644\u063a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u062e\u0648\u062f \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f \u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0639\u06a9\u0633 \u0631\u0633\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u062d\u0644 \u062a\u0639\u0628\u06cc\u0647 \u0634\u062f\u0647\u060c \u0622\u067e\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f.",PAYMENT_RECEIPT:"\u0644\u0637\u0641\u0627 \u0631\u0633\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a \u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0645\u0639\u0627\u0645\u0644\u0647 \u0646\u0632\u062f \u062e\u0648\u062f \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f.",PAY_ATTENTION:"\u0628\u0647 \u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u0628\u0627\u0642\u06cc\u0645\u0627\u0646\u062f\u0647 \u062c\u0647\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u062f\u0642\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f",PAY_WITH_BANK:"\u062c\u0647\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0627 \u06a9\u0627\u0631\u062a \u0628\u0627\u0646\u06a9\u06cc \u0645\u06cc\u062a\u0648\u0627\u0646\u06cc\u062f \u0645\u0628\u0644\u063a \u0631\u0627 \u0627\u0632 \u06cc\u06a9 \u06cc\u0627 \u0686\u0646\u062f \u06a9\u0627\u0631\u062a \u0627\u0631\u0633\u0627\u0644 \u06a9\u0646\u06cc\u062f",NOTE_BANK_CARDS:"\u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u0647\u0645\u0647\u200c\u06cc \u06a9\u0627\u0631\u062a\u200c\u0647\u0627\u06cc \u0628\u0627\u0646\u06a9\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647\u200c\u0634\u062f\u0647 \u0628\u0627\u06cc\u062f \u062d\u062a\u0645\u0627 \u0628\u0647 \u0646\u0627\u0645 \u062e\u0648\u062f\u062a\u0627\u0646 \u0628\u0627\u0634\u062f. \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646\u0635\u0648\u0631\u062a \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0645\u06cc\u062a\u0648\u0627\u0646\u062f \u0645\u0628\u0644\u063a \u0631\u0627 \u0646\u067e\u0630\u06cc\u0631\u062f\u060c \u0645\u0639\u0627\u0645\u0644\u0647 \u0641\u0633\u062e \u0634\u062f\u0647 \u0648 \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631 \u0627\u06cc\u0646 \u0642\u0628\u0627\u0644 \u0646\u062f\u0627\u0631\u062f.",ENSURE_AMOUNT_SEND:"\u062f\u0631 \u0627\u0631\u0633\u0627\u0644 \u0645\u0628\u0644\u063a \u062f\u0642\u062a \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0628\u06cc\u0634\u062a\u0631 \u06cc\u0627 \u06a9\u0645\u062a\u0631 \u0646\u0628\u0627\u0634\u062f. \u062f\u0631 \u0627\u06cc\u0646\u200c\u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0627\u0632 \u0633\u0645\u062a \u067e\u0644\u062a\u0641\u0631\u0645 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f \u0648 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062d\u0644 \u0645\u0634\u06a9\u0644 \u0632\u0645\u0627\u0646 \u0632\u06cc\u0627\u062f\u06cc \u0628\u0628\u0631\u062f.",AFTER_PAYMENT:"\u0628\u0639\u062f \u0627\u0632 \u0647\u0631 \u067e\u0631\u062f\u0627\u062e\u062a\u060c \u0634\u0645\u0627\u0631\u0647 \u06a9\u0627\u0631\u062a\u060c \u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc(\u0627\u0631\u062c\u0627\u0639) \u0648 \u0645\u0628\u0644\u063a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u062e\u0648\u062f \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f \u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0639\u06a9\u0633 \u0631\u0633\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u062d\u0644 \u062a\u0639\u0628\u06cc\u0647\u200c\u0634\u062f\u0647\u060c \u0622\u067e\u0644\u0648\u062f \u0646\u0645\u0627\u06cc\u06cc\u062f.",PAYMENT_RECEIPTS:"\u0644\u0637\u0641\u0627 \u0631\u0633\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0645\u0639\u0627\u0645\u0644\u0647 \u0646\u0632\u062f \u062e\u0648\u062f \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f",CONDUCT_TRANSACTION:"\u0628\u0647 \u0647\u06cc\u0686 \u0639\u0646\u0648\u0627\u0646 \u0628\u0627 \u0647\u06cc\u0686 \u0641\u0631\u0645 \u062c\u0627\u200c\u0628\u0647\u200c\u062c\u0627\u06cc\u06cc \u067e\u0648\u0644 \u06a9\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u06a9\u0627\u0646\u0627\u0644 \u062b\u0627\u0644\u062b\u06cc \u0647\u0645\u0686\u0648\u0646 \u0634\u0628\u06a9\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u06cc\u0627 \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646\u200c\u0647\u0627 \u0648 \u06cc\u0627 \u0645\u0639\u0627\u0645\u0644\u0647\u200c\u06cc \u0631\u0648\u062f\u0631\u0631\u0648\u060c \u0645\u0639\u0627\u0645\u0644\u0647\u200c\u0627\u06cc \u0627\u0646\u062c\u0627\u0645 \u0646\u062f\u0647\u06cc\u062f. \u067e\u0644\u062a\u0641\u0631\u0645 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0645\u0633\u0626\u0648\u0644 \u062e\u0633\u0627\u0631\u062a \u0648 \u06cc\u0627 \u0636\u0631\u0631\u06cc \u0628\u0627\u0634\u062f \u06a9\u0647 \u062e\u0627\u0631\u062c \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647\u200c\u0627\u0633\u062a.",ADDITIONALLY:"\u0647\u0645\u0686\u0646\u06cc\u0646 \u067e\u0644\u062a\u0641\u0631\u0645 \u0647\u06cc\u0686 \u062f\u062e\u0644 \u0648 \u062a\u0635\u0631\u0641\u06cc \u062f\u0631 \u0645\u0639\u0627\u0645\u0644\u0627\u062a P2P \u0646\u062f\u0627\u0631\u062f \u0648 \u0635\u0631\u0641\u0627 \u0627\u06cc\u0646 \u0628\u0633\u062a\u0631 \u0631\u0627 \u062c\u0647\u062a \u0627\u0646\u062c\u0627\u0645 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0634\u0645\u0627 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0631\u062f\u0647\u200c\u0627\u0633\u062a."},CUSTOMER_PAYMENT_INFORMATION:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u0634\u062a\u0631\u06cc",PAYMENT_INFORMATION:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a",TOO_MUCH_DEPOSITED:"\u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0628\u0644\u063a \u0628\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062f\u0627\u0632\u0647 \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0644\u0637\u0641\u0627 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06c
f\u0648\u0644\u064a\u0629\u060c \u062e\u0627\u0635\u0629 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0645\u062b\u0644 CoinBase \u0648Kraken\u060c \u0627\u0644\u062a\u064a \u062a\u0641\u0631\u0636 \u0642\u064a\u0648\u062f\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0625\u064a\u0631\u0627\u0646\u064a\u064a\u0646. \u0625\u0630\u0627 \u0644\u0632\u0645 \u0627\u0644\u0623\u0645\u0631\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u0645\u062d\u0641\u0638\u0629 \u0634\u062e\u0635\u064a\u0629\u060c \u0639\u0646\u0627\u0648\u064a\u0646 \u0645\u0624\u0642\u062a\u0629\u060c \u0648\u0637\u0631\u0642 \u062a\u062d\u0648\u064a\u0644 \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0637\u0628\u0642\u0627\u062a \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0623\u0635\u0648\u0644\u0643 \u0622\u0645\u0646\u0629.",DEPOSIT_ADDRESS:"\u0639\u0646\u0648\u0627\u0646 \u0625\u064a\u062f\u0627\u0639 Tether",ASSETS_SECURITY:"\u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0623\u0635\u0648\u0644\u0643 \u0622\u0645\u0646\u0629\u060c \u064a\u0631\u062c\u0649 \u0625\u064a\u062f\u0627\u0639 Tether \u0641\u0642\u0637 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0648\u0627\u0646. \u0642\u062f \u064a\u0624\u062f\u064a \u0625\u064a\u062f\u0627\u0639 \u0623\u064a \u0639\u0645\u0644\u0629 \u0623\u062e\u0631\u0649 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0625\u0644\u0649 \u062e\u0633\u0627\u0631\u0629 \u0623\u0635\u0648\u0644\u0643.",SELECT_TRANSFER_NETWORK:"\u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u0625\u064a\u062f\u0627\u0639 Tether\u060c \u0642\u0645 \u0623\u0648\u0644\u0627\u064b \u0628\u062a\u062d\u062f\u064a\u062f \u0634\u0628\u0643\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644."},DIRECT_DEPOSIT:{DIRECT_DEPOSIT_TITLE:"\u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u0646\u0643\u064a",ALERT:"\u06
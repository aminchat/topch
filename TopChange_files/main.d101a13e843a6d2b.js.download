627 \u062f\u0631\u06cc\u0627\u0641\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f."}},TRANSFER_LERANING:{TITLE:"\u062c\u0647\u062a \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 TopChange \u0628\u0647 GreenChange  \u0686\u0647 \u06a9\u0646\u0645\u061f",QUESTION_ONE_LOGIN_TITLE:"\u062a\u0631\u0627\u06a9\u0646\u0634 \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u062f\u0631 TopChange \u062f\u0627\u0634\u062a\u0647 \u0627\u0645",QUESTION_ONE_LOGIN_DESCRIPTION:"\u0627\u06cc\u0646 \u062f\u0633\u062a\u0647 \u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0627 \u0647\u0645\u0627\u0646 \u0627\u06cc\u0645\u06cc\u0644 \u0648 \u06a9\u0644\u0645\u0647 \u0639\u0628\u0648\u0631 \u062d\u0633\u0627\u0628 TopChange \u062e\u0648\u062f \u0642\u0627\u062f\u0631 \u0628\u0647 \u0648\u0631\u0648\u062f \u0628\u0647 \u0633\u0627\u06cc\u062a GreenChange \u0647\u0633\u062a\u0646\u062f \u0648 \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062b\u0628\u062a \u0646\u0627\u0645 \u0648 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062f\u0631 \u0633\u0627\u06cc\u062a GreenChange \u0646\u062e\u0648\u0627\u0647\u0646\u062f \u062f\u0627\u0634\u062a.<br/>\u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062e\u0648\u062f \u0628\u0631 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0641\u06cc\u0627\u062a \u062f\u0631 TopChange \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u0646\u062f \u0648\u0644\u06cc\u06a9\u0646 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u0628\u0647 GreenChange\u060c \u0645\u0628\u0627\u062f\u0644\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062e\u0635\u0648\u0635 \u0631\u0645\u0632 \u0627\u0631\u0632\u0647\u0627 \u062f\u0631 \u0648\u0628\u0633\u0627\u06cc\u062a GreenChange \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u0646\u062f",QUESTION_ONE_LOGIN_BTN:"\u0648\u0631\u0648\u062f \u0628\u0647 GreenChange",QUESTION_ONE_REGISTER_TITLE:"\u062a\u0627 \u06a9\u0646\u0648\u0646 \u062b\u0628\u062a \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u0631 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 TopChange \u0646\u062f\u0627\u0634\u062a\u0647 \u0627\u0645!",QUESTION_ONE_REGISTER_DESCRIPTION:"\u0627\u06cc\u0646 \u062f\u0633\u062a\u0647 \u0627\u0632 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0647\u0645 \u0645\u06cc \u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062e\u0648\u062f \u0628\u0631 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0641\u06cc\u0627\u062a \u062f\u0631 TopChange \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u0646\u062f. \u0627\u0645\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc\u06a9\u0647 \u0639\u0644\u0627\u0642\u0645\u0646\u062f \u0628\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0631\u0645\u0632 \u0627\u0631\u0632\u0647\u0627 \u0628\u0627\u0634\u0646\u062f \u0628\u0627\u06cc\u062f \u062f\u0631 \u0633\u0627\u06cc\u062a GreenChange \u062b\u0628\u062a \u0646\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0648 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0628\u0646\u0645\u0627\u06cc\u0646\u062f.",QUESTION_ONE_REGISTER_BTN:"\u062b\u0628\u062a \u0646\u0627\u0645 \u062f\u0631 GreenChange ",TRANSFER_DEADLINE:"\u0622\u062e\u0631\u06cc\u0646 \u0645\u0647\u0644\u062a \u062c\u0647\u062a \u0627\u0646\u062c\u0627\u0645 \u0627\u0646\u062a\u0642\u0627\u0644: 27 \u062a\u06cc\u0631 \u0645\u0627\u0647 \u0633\u0627\u0639\u062a 16:00 ",QUESTION_TWO_REGISTER_DESCRIPTION:'\u0634\u0645\u0627 \u062f\u0631 \u0637\u0648\u0644 \u0627\u06cc\u0646 \u0645\u062f\u062a \u0641\u0631\u0635\u062a \u062f\u0627\u0631\u06cc\u062f \u062a\u0627 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u062e\u0648\u062f \u0631\u0627 \u0627\u0632 <span class="tc-span">TopChange</span> \u0628\u0647 <span class="gc-span">GreenChange</span> \u0645\u0646\u062a\u0642\u0644 \u06a9\u0646\u06cc\u062f \u0648 \u06cc\u0627 \u0646\u0633\u0628\u062a \u0628\u0647 \u0628\u0631\u062f\u0627\u0634\u062a \u0645\u0648\u062c\u0648\u062f\u06cc \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u062e\u0648\u062f \u0627\u0642\u062f\u0627\u0645 \u0646\u0645\u0627\u06cc\u06cc\u062f\u060c \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646\u0635\u0648\u0631\u062a \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u0634\u0645\u0627 \u062f\u0631 \u062a\u0627\u0631\u06cc\u062e 27 \u062a\u06cc\u0631 \u0645\u0627\u0647 \u0633\u0627\u0639\u062a 16:00 \u0635\u0628\u062d \u0628\u0647 \u0635\u0648\u0631\u062a \u0627\u062a\u0648\u0645\u0627\u062a\u06cc\u06a9 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc \u06af\u06cc\u0631\u06cc\u062f.'},TRANSFER_REPORT:{TITLE:"\u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc TopChange \u0628\u0647 \u0648\u0628 \u0633\u0627\u06cc\u062a GreenChange",DESCRIPTION:"\ufb90\ufe8e\u0631\ufe91\ufeae \ufb94\ufeae\u0627\ufee3\ufbfd \u062f\u0631 \ufeb3\ufe8e\ufbfe\ufe96 GreenChange \ufb90\ufe8e\u0631\ufe91\ufeae\u06cc \ufe91\ufe8e \ufee3\ufeb8\ufea8\ufebc\ufe8e\u062a \u0634\u0645\u0627 \u0648\ufe9f\ufeee\u062f \u062f\u0627\u0631\u062f\u060c \u062f\u0631 \ufebb\ufeee\u0631\ufe97\ufbfd \ufb90\ufeea \u0627\ufbfe\ufee6 \ufea3\ufeb4\ufe8e\u0628 \ufb90\ufe8e\u0631\ufe91\ufeae\u06cc \ufee3\ufe98\ufecc\ufee0\ufed6 \ufe91\ufeea \ufeb7\ufee4\ufe8e \ufee3\ufbfd \ufe91\ufe8e\ufeb7\ufeaa \ufee7\ufeb4\ufe92\ufe96 \ufe91\ufeea \u0627\u062f\u0627\ufee3\ufeea \u0627\ufee7\ufe98\ufed8\ufe8e\u0644 \u0627\ufed7\ufeaa\u0627\u0645 \ufee7\ufee4\ufe8e\ufbfe\ufbff\ufeaa\u060c \u062f\u0631 \ufecf\ufbff\ufeae \u0627\ufbfe\ufee8\ufebc\ufeee\u0631\u062a \u0627\u0632 \ufe91\ufea8\ufeb6 \ufe97\ufbff\ufb91\ufe96 \ufe91\ufe8e \ufee3\ufe8e \u062f\u0631 \u0627\u0631\ufe97\ufe92\ufe8e\u0637 \ufe91\ufe8e\ufeb7\ufbff\ufeaa.",WALLET:"\u06a9\u06cc\u0641 \u067e\u0648\u0644",PRICE:"\u0645\u0628\u0644\u063a",CLICK_HERE:"\u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f!",I_WANT_MORE_ABOUT_TRANSFER:"\u0645\u06cc \u062e\u0648\u0627\u0647\u0645 \u062f\u0631 \u0645\u0648\u0631\u062f \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632 \u0627\u0631\u0632 \u0628\u06cc\u0634\u062a\u0631 \u0628\u062f\u0627\u0646\u0645.",BOX_INFO:{TITLE:"\u0645\u0634\u062e\u0635\u0627\u062a",TEXT:'\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0627\u06cc\u0646\u06a9\u0647 \u0634\u0645\u0627 \u0642\u0628\u0644\u0627 \u062f\u0631 \u0633\u0627\u06cc\u062a Topchange \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647 \u06cc \u0631\u0645\u0632\u0627\u0631\u0632\u0647\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f\u0647 \u0627\u06cc\u062f \u06cc\u06a9 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0633\u0627\u06cc\u062a Greenchange \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0648\u0631\u0648\u062f \u0628\u0647 \u0622\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0648\u0631\u0648\u062f \u062d\u0633\u0627\u0628 Topchange \u062e\u0648\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f. \u0644\u0637\u0641\u0627 \u0627\u06cc\u0646 \u0645\u0648\u0631\u062f \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0631\u062f\u0647 \u0648 \u062f\u0631 \u0635\u0648\u0631\u062a \u062a\u0627\u06cc\u06cc\u062f \u0639\u0645\u0644\u06cc\u0627\u062a \u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0648\u062c\u0648\u062f\u06cc \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627 \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f\u060c \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646\u0635\u0648\u0631\u062a \u0627\u0632 \u0628\u062e\u0634<a href="/support/tickets"> \u062a\u06cc\u06a9\u062a </a> \u0628\u0627 \u0645\u0627 \u062f\u0631 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627\u0634\u06cc\u062f.',FULL_NAME:"\u0646\u0627\u0645 \u0648 \u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc",USERNAME:"\u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc",DATE_OF_BIRTH:"\u062a\u0627\u0631\u06cc\u062e \u062a\u0648\u0644\u062f",NATIONAL_CODE:"\u0634\u0645\u0627\u0631\u0647 \u0645\u0644\u06cc",PASSPORT:"\u067e\u0627\u0633\u067e\u0648\u0631\u062a"},CHECK_INFO_TXT:"\u0645\u0634\u062e\u0635\u0627\u062a \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0633\u0627\u06cc\u062a GreenChange \u0645\u062a\u0639\u0644\u0642 \u0628\u0647 \u0645\u0646 \u0645\u06cc \u0628\u0627\u0634\u062f.",CHECK_POLICY_TXT:"\u0627\u06cc\u0646\u062c\u0627\u0646\u0628 \u0645\u06cc \u067e\u0630\u06cc\u0631\u0645 \u06a9\u0647 :<br/><ul><li>\u06cc\u06a9 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062c\u062f\u06cc\u062f \u062f\u0631\u0633\u0627\u06cc\u062a \u06af\u0631\u06cc\u0646 \u0686\u0646\u062c (https://greenchange.io) \u0628\u0631\u0627\u06cc \u0645\u0627 \u0633\u0627\u062e\u062a\u0647 \u0634\u0648\u062f.</li><li>\u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f \u062f\u0631 GreenChange \u0645\u0646 \u0628\u0627\u06cc\u062f \u0627\u0632 \u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0648 \u06a9\u0644\u0645\u0647 \u0639\u0628\u0648\u0631 \u062e\u0648\u062f \u062f\u0631 TopChange \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u0627\u06cc\u0645.</li><li>\u062a\u0645\u0627\u0645 \u062f\u0627\u0631\u0627\u06cc\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u0645\u0646 \u062f\u0631 TopChange \u0628\u0647 GreenChange \u0645\u0646\u062a\u0642\u0644 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.</li></ul>",TRANSFER_BTN:"\u0627\u0646\u062a\u0642\u0627\u0644"},CONFIRM_DIALOG:{TITLE:"\u062a\u0627\u0626\u06cc\u062f \u0627\u0646\u062a\u0642\u0627\u0644",ENTER_CODE:"\u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062e\u0648\u062f\u060c \u0644\u0637\u0641\u0627 \u06a9\u062f \u062a\u0623\u06cc\u06cc\u062f\u06cc \u0631\u0627 \u06a9\u0647 \u0628\u0647 <span>{{phoneNumber}}</span> \u0648 <span>{{userEmail}}</span> \u0627\u0631\u0633\u0627\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f.",CANCEL:"\u0644\u063a\u0648"},LEARN_FILES:{TITLE:"\u0641\u0627\u06cc\u0644 \u0647\u0627\u06cc \u0622\u0645\u0648\u0632\u0634\u06cc",FILE_NAME1:"\u0631\u0648\u0634 \u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0628\u0644\u063a \u0627\u0632 GreenChange \u0628\u0647 TopChange",FILE_NAME2:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a",FILE_NAME3:"\u0631\u0648\u0634 \u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0628\u0644\u063a \u0627\u0632 TopChange \u0628\u0647 GreenChange"},ALERT:{TRANSFER_DONE_SUCCESSFULLY:"\u0639\u0645\u0644\u06cc\u0627\u062a \u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u06af\u0631\u062f\u06cc\u062f.",TRANSFER_DONE:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc\u060c \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u0634\u0645\u0627 \u0627\u0632 TopChange \u0628\u0647 GreenChange \u0628\u0627 \u0645\u0648\u0641\u0642\u0
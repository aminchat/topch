ED_RANGE:"\u0628\u0627\u0632\u0647 \u0645\u062c\u0627\u0632: {{min}} - {{max}}",ALLOWED_RANGE_PERCENTAGE:"\u0628\u0627\u0632\u0647 \u0645\u062c\u0627\u0632: <span class='percent-range'>{{min}}% - {{max}}%</span>",ERROR_VALIDATE_ALLOWED_RANGE:"\u0646\u0631\u062e \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u0628\u0627\u06cc\u062f \u062f\u0631 \u0628\u0627\u0632\u0647 \u0645\u062c\u0627\u0632 {{min}} - {{max}} \u0628\u0627\u0634\u062f.",ERROR_VALIDATE_ALLOWED_RANGE_PERCENTAGE:"\u062f\u0631\u0635\u062f \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u0628\u0627\u06cc\u062f \u062f\u0631 \u0628\u0627\u0632\u0647 \u0645\u062c\u0627\u0632 <span class='percent-range'>{{min}}% - {{max}}%</span> \u0628\u0627\u0634\u062f.",TEXT_CHANGE_PERCENT_LOWER:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 {{value}}\u066a \u067e\u0627\u06cc\u06cc\u0646\u200c\u062a\u0631 \u0627\u0632 \u0646\u0631\u062e \u062a\u0627\u067e\u200c\u0686\u0646\u062c \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",TEXT_CHANGE_PERCENT_HIGHER:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 {{value}}\u066a \u0628\u0627\u0644\u0627\u062a\u0631 \u0627\u0632 \u0646\u0631\u062e \u062a\u0627\u067e\u200c\u0686\u0646\u062c \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",TEXT_CHANGE_PERCENT_STATIC:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0628\u0631\u0627\u0628\u0631 \u0628\u0627 \u0646\u0631\u062e \u062a\u0627\u067e\u200c\u0686\u0646\u062c \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",TEXT_CHANGE_PERCENT_LOWER_CRYPTO:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 {{value}}\u066a \u067e\u0627\u06cc\u06cc\u0646\u200c\u062a\u0631 \u0627\u0632 \u0646\u0631\u062e \u0628\u0627\u0632\u0627\u0631 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",TEXT_CHANGE_PERCENT_HIGHER_CRYPTO:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 {{value}}\u066a \u0628\u0627\u0644\u0627\u062a\u0631 \u0627\u0632 \u0646\u0631\u062e \u0628\u0627\u0632\u0627\u0631 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",TEXT_CHANGE_PERCENT_STATIC_CRYPTO:"\u0646\u0631\u062e \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0647\u0645\u06cc\u0634\u0647 \u0628\u0631\u0627\u0628\u0631 \u0628\u0627 \u0646\u0631\u062e \u0628\u0627\u0632\u0627\u0631 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",AMOUNT_PAID:"\u0645\u0628\u0644\u063a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc",EXCHANGE_RATE:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644",ORDER_TRACKING_NUMBER:"\u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0633\u0641\u0627\u0631\u0634",AD_TRACKING_NUMBER:"\u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0622\u06af\u0647\u06cc",DESTINATION_BANK:"\u0628\u0627\u0646\u06a9 \u0645\u0642\u0635\u062f",VIEW_DESTINATION_BANK:"\u0645\u0634\u0627\u0647\u062f\u0647 \u0628\u0627\u0646\u06a9 \u0645\u0642\u0635\u062f",VIEW_DESTINATION_BANK_DESCRIPTION:"\u0627\u0632 \u0627\u06cc\u0646 \u0628\u0647 \u0628\u0639\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627\u0646\u06a9 \u0645\u0642\u0635\u062f \u0622\u06af\u0647\u06cc\u200c\u062f\u0647\u0646\u062f\u0647 \u0631\u0627 \u067e\u06cc\u0634 \u0627\u0632 \u0648\u0631\u0648\u062f \u0628\u0647 \u0645\u0639\u0627\u0645\u0644\u0647 \u0628\u0628\u06cc\u0646\u06cc\u062f \u062a\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u062f\u0642\u06cc\u0642\u200c\u062a\u0631\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f.",BANK_NAME:"\u0628\u0627\u0646\u06a9 {{name}}",DIALOG_EXCHANGE_RATE:{CHANGE:{TITLE:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u0648\u0627\u0631\u062f\u0634\u062f\u0647 \u0628\u0627 \u0646\u0631\u062e \u0641\u0639\u0644\u06cc \u062a\u0641\u0627\u0648\u062a \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f",NEW_EXCHANGERATE:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u0634\u0645\u0627:",TC_EXCHANGERATE:"\u0646\u0631\u062e \u0641\u0639\u0644\u06cc \u062e\u0631\u06cc\u062f \u0627\u0632 \u062a\u0627\u067e\u200c\u0686\u0646\u062c:",DESCRIPTON:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644\u06cc \u06a9\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u0628\u0627 \u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u0641\u0639\u0644\u06cc \u062f\u0631 TC \u0627\u062e\u062a\u0644\u0627\u0641 \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f. \u0644\u0637\u0641\u0627\u064b \u0642\u0628\u0644 \u0627\u0632 \u062b\u0628\u062a\u060c \u0622\u0646 \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f. \u0622\u06cc\u0627 \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0642\u062f\u0627\u0631 \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f\u061f",EDIT_EXCHANGE_RATE:"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644",CONTINUE:"\u0627\u062f\u0627\u0645\u0647"}},PRICE_TOLERANCE_VALIDATION_FAILED:"\u0642\u06cc\u0645\u062a \u0648\u0627\u0631\u062f\u0634\u062f\u0647 \u0627\u062e\u062a\u0644\u0627\u0641 \u0632\u06cc\u0627\u062f\u06cc \u0628\u0627 \u0642\u06cc\u0645\u062a \u0628\u0627\u0632\u0627\u0631 \u062f\u0627\u0631\u062f. \u0644\u0637\u0641\u0627\u064b \u0622\u0646 \u0631\u0627 \u0627\u0635\u0644\u0627\u062d \u06a9\u0631\u062f\u0647 \u0648 \u0645\u062c\u062f\u062f\u0627\u064b \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f.",DIALOG_TERMS_COMMITMENT_AGREEMENT:{ALERT_TXT:"\u0644\u0637\u0641\u0627 \u0642\u0628\u0644 \u0627\u0632 \u062b\u0628\u062a \u0622\u06af\u0647\u06cc \u0628\u0627 \u062f\u0642\u062a \u0642\u0648\u0627\u0646\u06cc\u0646 \u0631\u0627 \u0645\u0637\u0627\u0644\u0639\u0647 \u06a9\u0646\u06cc\u062f!"},ACTIVE_ORDERS_AD_VISIBILITY_WARNING:"\u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u06f4 \u0633\u0641\u0627\u0631\u0634 \u0628\u0631\u0627\u06cc \u0622\u06af\u0647\u06cc \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u060c \u0622\u06af\u0647\u06cc \u0634\u0645\u0627 \u0628\u0647 \u0637\u0648\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u067e\u0646\u0647\u0627\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f.",SUPPORT_REQUESTS_AD_VISIBILITY_WARNING:"\u0628\u0647 \u0645\u062d\u0636 \u0627\u06cc\u0646\u06a9\u0647 \u06f3 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0639\u0644\u06cc\u0647 \u0633\u0641\u0627\u0631\u0634\u0627\u062a \u062e\u0648\u062f \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f\u060c \u0647\u0645\u0647 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0634\u0645\u0627 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0648\u0642\u062a \u067e\u0646\u0647\u0627\u0646 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f.",FINAL_P2P_TRANSACTION_WARNING:"\u0645\u0639\u0627\u0645\u0644\u0627\u062a P2P \u0646\u0647\u0627\u06cc\u06cc \u0647\u0633\u062a\u0646\u062f\u061b \u0642\u0628\u0644 \u0627\u0632 \u062b\u0628\u062a \u0633\u0641\u0627\u0631\u0634\u060c \u0645\u0628\u0644\u063a\u060c \u0642\u06cc\u0645\u062a \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u0628\u0627 \u062f\u0642\u062a \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f.",P2P_COLLATERAL_NOTICE:"\u0645\u0628\u0644\u063a \u0648\u062b\u06cc\u0642\u0647 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0636\u0645\u0627\u0646\u062a \u06a9\u0627\u0631\u0628\u0631 \u0628\u0631\u0627\u06cc \u0631\u0639\u0627\u06cc\u062a \u0627\u0635\u0648\u0644 \u0648 \u0642\u0648\u0627\u0646\u06cc\u0646 P2P \u067e\u0644\u062a\u0641\u0631\u0645 \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a.\u0627\u06cc\u0646 \u0645\u0628\u0644\u063a \u0628\u0639\u062f \u0627\u0632 \u0628\u0633\u062a\u0647 \u0634\u062f\u0646 \u0622\u06af\u0647\u06cc\u060c \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0628\u0627\u0632 \u062e\u0648\u0627\u0647\u062f \u06af\u0634\u062a.",P2P_SERVICE_RESTRICTION_WARNING:"\u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u062a\u062e\u0637\u06cc \u0627\u0632 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0645\u0634\u062e\u0635\u200c\u0634\u062f\u0647\u060c \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0645\u0631\u0628\u0648\u0637\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0634\u0645\u0627 \u0631\u0627 \u0627\u0632 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633 P2P \u0628\u0647 \u0635\u0648\u0631\u062a \u0645\u0648\u0642\u062a \u06cc\u0627 \u062f\u0627\u0626\u0645 \u0645\u0646\u0639 \u06a9\u0646\u062f.",P2P_SEND_METHOD_PRICE_NOTICE:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc\u060c \u0628\u0631\u0627\u06cc \u0645\u0628\u0627\u0644\u063a \u062a\u0627 \u0633\u0642\u0641 \u06f1\u06f5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u062a\u0648\u0645\u0627\u0646\u060c \u0648\u0627\u0631\u06cc\u0632 \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u06a9\u0627\u0631\u062a\u200c\u0628\u0647\u200c\u06a9\u0627\u0631\u062a \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0645\u0628\u0627\u0644\u063a \u0628\u06cc\u0634 \u0627\u0632 \u06f1\u06f5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u062a\u0627 \u0633\u0642\u0641 \u06f2\u06f0\u06f0 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u062a\u0648\u0645\u0627\u0646\u060c \u0644\u0637\u0641\u0627\u064b \u0627\u0632 \u0631\u0648\u0634 \u062d\u0633\u0627\u0628\u200c\u0628\u0647\u200c\u062d\u0633\u0627\u0628 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f. \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0648\u0634\u060c \u0628\u0627\u0646\u06a9 \u0645\u0628\u062f\u0623 \u0648 \u0645\u0642\u0635\u062f \u0628\u0627\u06cc\u062f \u06cc\u06a9\u0633\u0627\u0646 \u0628\u0627\u0634\u062f \u0648 \u0627\u0632 \u0627\u0646\u062a\u0642\u0627\u0644 \u0648\u062c\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0634\u0645\u0627\u0631\u0647 \u0634\u0628\u0627 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u0641\u0631\u0645\u0627\u06cc\u06cc\u062f."},AFFILIATE:{AFFILIATE_REQUEST:{ENTER_CODE_DESCRIPTION:"\u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0639\u06cc\u0646 \u062d\u0627\u0644 \u06a9\u0647 \u0647\u0645\u06a9\u0627\u0631 \u0645\u0627 (Affiliate) \u0647\u0633\u062a\u06cc\u062f \u0627\u0632 \u0637\u0631\u0641 \u0634\u062e\u0635 \u062f\u06cc\u06af\u0631\u06cc \u0646\u06cc\u0632 \u062f\u0639\u0648\u062a \u0634\u0648\u06cc\u062f \u0648 \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0634\u0631\u0627\u06cc\u0637 \u062f\u0639\u0648\u062a\u200c\u06a9\u0646\u0646\u062f\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f.",ENTER_CODE:"\u062b\u0628\u062a \u06a9\u062f \u062f\u0639\u0648\u062a",AFFILIATE_CONDITIONS:"\u0634\u0631\u0627\u06cc\u0637 \u0639\u0636\u0648\u06cc\u062a",SOCIAL_MANAGEMENT_BLOCKCHAIN:"\u062f\u0627\u0634\u062a\u0646 \u06af\u0631\u0648\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u062f\u0631 \u062d\u0648\u0632\u0647\u200c\u06cc \u0628\u0627\u0632\u0627\u0631\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u0648 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u0627\u0631\u0632\u06cc \u06a9\u0647 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0622\u0646 \u0631\u0627 \u0628\u0631 \u0639\u0647\u062f\u0647 \u062f\u0627\u0631\u06cc\u062f.",ONLINE_FINANCIAL_PLATFORMS:"\u062d\u0636\u0648\u0631 \u0645\u0648\u062b\u0631 \u062f\u0631 \u0634\u0628\u06a9\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0645\u0631\u062a\u0628\u0637 \u0628\u0627 \u0628\u0627\u0632\u0627\u0631\u0647\u0627\u06cc \u0633\u0631\u0645\u0627\u06cc\u0647 \u0645\u0627\u0646\u0646\u062f \u06cc\u0648\u062a\u06cc\u0648\u0628, \u062a\u0648\u06cc\u06cc\u062a\u0631, \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u0648 \u062a\u0644\u06af\u0631\u0627\u0645.",COMMUNITY_EVENTS_ATTRACTION:"\u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u06a9\u0644\u0648\u067e\u200c\u0647\u0627\u06cc \u0647\u0648\u0627\u062f\u0627\u0631\u06cc , \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627 \u0648 \u06a9\u0646\u0641\u0631\u0627\u0646\u0633\u200c\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u0648 \u0627\u0645\u06a9\u0627\u0646 \u0627\u06cc\u062c\u0627\u062f \u0641\u0636\u0627\u06cc \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc \u0628\u0631\u0627\u06cc \u0633\u0648\u0642\u200c\u062f\u0647\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062c\u062f\u06cc\u062f \u0628\u0647 \u0633\u0645\u062a \u067e\u0644\u062a\u0641\u0631\u0645 TopChange",CONTENT_COLLABORATION_IMPACT:"\u062a\u062c\u0631\u0628\u0647 \u0648 \u062a\u0648\u0627\u0646\u0627\u06cc\u06cc \u0628\u0631\u0627\u06cc \u062a\u0648\u0644\u06cc\u062f \u0645\u062d\u062a\u0648\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0634\u062a\u0631\u06a9 \u0628\u0627 TopChange \u0648 \u0627\u0645\u06a9\u0627\u0646 \u062a\u0627\u062b\u06cc\u0631\u06af\u0630\u0627\u0631\u06cc \u0628\u0631 \u06af\u0631\u0648\u0647\u200c\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u06a9\u0627\u0631\u0628\u0631\u06cc",SEND_REQUEST:"\u0627\u06af\u0631 \u0642\u0635\u062f \u062f\u0627\u0631\u06cc\u062f \u0639\u0636\u0648\u06cc \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633 \u0647\u0645\u06a9\u0627\u0631\u06cc TopChange \u0628\u0627\u0634\u06cc\u062f\u060c \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f:",SEE_FORM:"\u0641\u0631\u0645 \u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a Affiliate"},AFFILIATE_SEND_REQUEST:{SEND_AFFLIATE_REQUEST:"\u0627\u0631\u0633\u0627\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0647\u0645\u06a9\u0627\u0631\u06cc",WEBSITE_ADDRESS:"\u0622\u062f\u0631\u0633 \u0648\u0628\u0633\u
28\u0637\u0627\u0642\u0627\u062a\u060c \u0645\u0646 \u0627\u0644\u0645\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0634\u062a\u0631\u064a \u0642\u062f \u0627\u0633\u062a\u062e\u062f\u0645 \u0639\u062f\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u0628\u0646\u0643\u064a\u0629\u060c \u0644\u0630\u0627 \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0625\u064a\u062f\u0627\u0639 \u0628\u0639\u0646\u0627\u064a\u0629.",INFORMATION_DISCREPANCY:'\u0641\u064a \u062d\u0627\u0644\u0629 \u0648\u062c\u0648\u062f \u0623\u064a \u062a\u0646\u0627\u0642\u0636 \u0641\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0628\u0627\u0626\u0639\u060c \u0644\u0627 \u062a\u0642\u0645 \u0628\u0627\u0644\u0625\u0641\u0631\u0627\u062c \u0639\u0646 \u0639\u0645\u0644\u062a\u0643 \u0648\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 "\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\u0629". \u0644\u0646 \u0646\u0643\u0648\u0646 \u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0639\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0645\u062f\u0641\u0648\u0639\u0627\u062a\u0643 \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0641\u0631\u0627\u062c \u0627\u0644\u062e\u0627\u0637\u0626.',IMPORTANT_INFORMATION:"\u0644\u0627 \u062a\u0639\u0637\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0645\u0635\u0631\u0641\u064a\u0629 \u0627\u0644\u062d\u0633\u0627\u0633\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062d\u062a\u0649 \u0644\u0627 \u064a\u062a\u0645 \u0625\u0633\u0627\u0621\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627.",TRANSFORM_THROUGH_CHANNEL:"\u064a\u062c\u0628 \u0623\u0644\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0623\u064a \u0637\u0631\u064a\u0642\u0629 \u062a\u062d\u0648\u064a\u0644 \u0623\u0645\u0648\u0627\u0644 \u064a\u062a\u0645 \u0627\u0644\u0625\u0639\u0644\u0627\u0646 \u0639\u0646\u0647\u0627 \u0639\u0628\u0631 \u0642\u0646\u0648\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629 \u0645\u062b\u0644 \u0634\u0628\u0643\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0623\u0648 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0629 \u0623\u0648 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629. \u0627\u0644\u0645\u0646\u0635\u0629 \u063a\u064a\u0631 \u0645\u0633\u0624\u0648\u0644\u0629 \u0639\u0646 \u0623\u064a \u0623\u0636\u0631\u0627\u0631 \u062a\u062d\u062f\u062b \u062e\u0627\u0631\u062c\u0647\u0627. \u0643\u0645\u0627 \u0623\u0646 \u0627\u0644\u0645\u0646\u0635\u0629 \u0644\u0627 \u062a\u062f\u0639\u0645 P2P \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646.",PAYMENT_SPECIFIED_TIME:'\u064a\u0631\u062c\u0649 \u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u062f\u0641\u0639 \u062e\u0644\u0627\u0644 \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062d\u062f\u062f \u0648\u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0632\u0631 "\u062a\u0645 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u062a\u0627\u0644\u064a". \u0628\u0639\u062f \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0628\u0627\u0626\u0639 \u0644\u0644\u062f\u0641\u0639\u060c \u064a\u0642\u0648\u0645 \u0627\u0644\u0646\u0638\u0627\u0645 \u0628\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0623\u0635\u0644 \u0627\u0644\u0631\u0642\u0645\u064a \u0625\u0644\u0649 \u062d\u0633\u0627\u0628\u0643.',POSSIBLE_MULTIPLE_CARD:"\u0628\u0633\u0628\u0628 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u062f\u0641\u0639 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0628\u064a\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a\u060c \u0645\u0646 \u0627\u0644\u0645\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0639\u062f\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u0628\u0646\u0643\u064a\u0629.",DEPOSIT_FROM_ACCOUNT:"\u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0625\u064a\u062f\u0627\u0639 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0645\u0646 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0635\u0631\u0641\u064a \u0627\u0644\u0630\u064a \u062a\u062e\u062a\u0627\u0631\u0647. \u0641\u064a \u062d\u0627\u0644\u0629 \u0648\u062c\u0648\u062f \u0623\u064a \u062a\u0646\u0627\u0642\u0636 \u0641\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0639\u060c \u0644\u0646 \u064a\u0642\u0648\u0645 \u0627\u0644\u0628\u0627\u0626\u0639 \u0628\u0627\u0644\u0625\u0641\u0631\u0627\u062c \u0639\u0646 \u0627\u0644\u0639\u0645\u0644\u0629 \u0648\u0644\u0646 \u064a\u0643\u0648\u0646 \u0645\u0633\u0624\u0648\u0644\u064b\u0627 \u0639\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u062f\u0641\u0639\u062a\u0643.",DEPOSIT_AMOUNT_CORRECTLY:"\u0643\u0646 \u062d\u0630\u0631\u064b\u0627 \u0639\u0646\u062f \u0625\u064a\u062f\u0627\u0639 \u0627\u0644\u0623\u0645\u0648\u0627\u0644\u060c \u0642\u0645 \u0628\u0625\u064a\u062f\u0627\u0639 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0635\u062d\u064a\u062d. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0645\u0628\u0644\u063a \u0627\u0644\u0625\u064a\u062f\u0627\u0639 \u0645\u0646\u062e\u0641\u0636\u064b\u0627\u060c \u0641\u0633\u062a\u0642\u0648\u0645 \u0627\u0644\u0645\u0646\u0635\u0629 \u0628\u0625\u064a\u062f\u0627\u0639 \u0639\u0645\u0644\u0629 \u062a\u0639\u0627\u062f\u0644 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0648\u062f\u0639 \u0641\u064a \u0645\u062d\u0641\u0638\u062a\u0643. \u0623\u064a\u0636\u064b\u0627\u060c \u0625\u0630\u0627 \u0642\u0645\u062a \u0628\u0625\u064a\u062f\u0627\u0639 \u0645\u0628\u0644\u063a \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u060c \u062d\u0627\u0648\u0644 \u0627\u0644\u062a\u062d\u062f\u062b \u0625\u0644\u0649 \u0627\u0644\u0628\u0627\u0626\u0639 \u0648\u062d\u0644 \u0627\u0644\u0645\u0634\u0643\u0644\u0629. \u0627\u0644\u0645\u0646\u0635\u0629 \u0644\u0646 \u062a\u0643\u0648\u0646 \u0645\u0633\u0624\u0648\u0644\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0635\u062f\u062f.",AFTER_EACH_PAYMENT:"\u0628\u0639\u062f \u0643\u0644 \u062f\u0641\u0639\u0629\u060c \u0623\u062f\u062e\u0644 \u0631\u0642\u0645 \u0628\u0637\u0627\u0642\u062a\u0643\u060c \u0631\u0642\u0645 \u0627\u0644\u062a\u062a\u0628\u0639 (\u0627\u0644\u0625\u062d\u0627\u0644\u0629)\u060c \u0648\u0645\u0628\u0644\u063a \u0627\u0644\u062f\u0641\u0639\u060c \u0643\u0645\u0627 \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631\u0629 \u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u062f\u0641\u0639 \u0641\u064a \u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u062e\u0635\u0635.",PAYMENT_RECEIPT:"\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u062f\u0641\u0639 \u062d\u062a\u0649 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629.",PAY_ATTENTION:"\u0627\u0646\u062a\u0628\u0647 \u0644\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062a\u0628\u0642\u064a \u0644\u0644\u062f\u0641\u0639.",PAY_WITH_BANK:"\u0644\u0644\u062f\u0641\u0639 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0637\u0627\u0642\u0629 \u0628\u0646\u0643\u064a\u0629\u060c \u064a\u0645\u0643\u0646\u0643 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0628\u0644\u063a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0637\u0627\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u0623\u0648 \u0639\u062f\u0629 \u0628\u0637\u0627\u0642\u0627\u062a.",NOTE_BANK_CARDS:"\u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u0628\u0627\u0633\u0645\u0643. \u0648\u0625\u0644\u0627\u060c \u0642\u062f \u064a\u0631\u0641\u0636 \u0627\u0644\u0628\u0627\u0626\u0639 \u0627\u0644\u062f\u0641\u0639\u060c \u0648\u0642\u062f \u064a\u062a\u0645 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0648\u0644\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0645\u0646\u0635\u0629 \u0645\u0633\u0624\u0648\u0644\u0629 \u0639\u0646 \u0630\u0644\u0643.",ENSURE_AMOUNT_SEND:"\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0630\u064a \u062a\u0631\u0633\u0644\u0647 \u0644\u064a\u0633 \u0623\u0642\u0644 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0637\u0644\u0648\u0628. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0643\u0630\u0644\u0643\u060c \u0641\u0633\u064a\u0643\u0648\u0646 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0635\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0628\u0627\u0626\u0639\u060c \u0648\u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0634\u0643\u0644\u0629 \u0648\u0642\u062a\u064b\u0627 \u0637\u0648\u064a\u0644\u064b\u0627.",AFTER_PAYMENT:"\u0628\u0639\u062f \u0643\u0644 \u062f\u0641\u0639\u0629\u060c \u0623\u062f\u062e\u0644 \u0631\u0642\u0645 \u0628\u0637\u0627\u0642\u062a\u0643\u060c \u0631\u0642\u0645 \u0627\u0644\u0625\u062d\u0627\u0644\u0629\u060c \u0648\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u060c \u0643\u0645\u0627 \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631\u0629 \u0625\u064a\u0635\u0627\u0644 \u0627\u0644\u062f\u0641\u0639 \u0641\u064a \u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u062e\u0635\u0635.",PAYMENT_RECEIPTS:"\u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0625\u064a\u0635\u0627\u0644\u0627\u062a \u0627\u0644\u062f\u0641\u0639 \u062d\u062a\u0649 \u062a\u0643\u062a\u0645\u0644 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629.",CONDUCT_TRANSACTION:"\u062a\u062d\u062a \u0623\u064a \u0638\u0631\u0641 \u0645\u0646 \u0627\u0644\u0638\u0631\u0648\u0641\u060c \u0644\u0627 \u064a\u0646\u0628\u063a\u064a \u0639\u0644\u064a\u0643 \u0625\u062c\u0631\u0627\u0621 \u0645\u0639\u0627\u0645\u0644\u0629 \u062a\u062d\u0648\u064a\u0644 \u0623\u0645\u0648\u0627\u0644 \u0639\u0628\u0631 \u0642\u0646\u0627\u0629 \u062e\u0627\u0631\u062c\u064a\u0629 \u0645\u062b\u0644 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0623\u0648 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0629 \u0623\u0648 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629. \u0627\u0644\u0645\u0646\u0635\u0629 \u0644\u064a\u0633\u062a \u0645\u0633\u0624\u0648\u0644\u0629 \u0639\u0646 \u0623\u064a \u062e\u0633\u0627\u0626\u0631 \u0623\u0648 \u0623\u0636\u0631\u0627\u0631 \u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0645 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0646\u0635\u0629.",ADDITIONALLY:"\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0644\u0643\u060c \u0644\u0627 \u062a\u062a\u062f\u062e\u0644 \u0627\u0644\u0645\u0646\u0635\u0629 \u0641\u064a \u0645\u0639\u0627\u0645\u0644\u0627\u062a P2P \u0648\u062a\u0648\u0641\u0631 \u0641\u0642\u0637 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a\u0643."},CUSTOMER_PAYMENT_INFORMATION:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062f\u0641\u0639 \u0627\u0644\u0639\u064
062f \u0646\u0645\u0627\u06cc\u06cc\u062f.",BANK_WAITING:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u0634\u062f\u060c \u0644\u0637\u0641\u0627  \u0645\u0646\u062a\u0638\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0633\u0627\u0628 \u062c\u0647\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0627\u0634\u06cc\u062f.",CASH_WAITING:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u0634\u062f\u060c \u0644\u0637\u0641\u0627  \u0645\u0646\u062a\u0638\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u062d\u0644 \u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0627\u0634\u06cc\u062f.",BANK_PAYMENT:"\u0644\u0637\u0641\u0627 \u0645\u0628\u0644\u063a \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u0628\u0647 \u062d\u0633\u0627\u0628 \u0630\u06a9\u0631 \u0634\u062f\u0647 \u0648\u0627\u0631\u06cc\u0632 \u0646\u0645\u0627\u06cc\u06cc\u062f.",CASH_PAYMENT:"\u067e\u0633 \u0627\u0632 \u062a\u062d\u0648\u06cc\u0644 \u0645\u0628\u0644\u063a\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u062b\u0628\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f.",ONLINE_PAYMENT:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u0634\u062f\u060c \u0644\u0637\u0641\u0627 \u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0648 \u0645\u0628\u0644\u063a \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u0627\u0646\u0644\u0627\u06cc\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f.",CREDIT_ENTER_PAYMENT_INFO:"\u0644\u0637\u0641\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u0648\u0627\u0631\u062f \u0646\u0645\u0627\u06cc\u06cc\u062f.",PAYMENT_EMONEY:"\u0644\u0637\u0641\u0627 \u0645\u0628\u0644\u063a \u0631\u0627 \u0628\u0647 \u062d\u0633\u0627\u0628 \u0630\u06a9\u0631 \u0634\u062f\u0647 \u0648\u0627\u0631\u06cc\u0632 \u0648 \u0633\u067e\u0633 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u062e\u0648\u062f \u0631\u0627 \u062b\u0628\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f.",GATEWAY_PAY:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u06af\u0631\u062f\u06cc\u062f. \u0644\u0637\u0641\u0627 \u0628\u0627 \u06a9\u0644\u06cc\u06a9 \u0628\u0631 \u0631\u0648\u06cc \u062f\u06a9\u0645\u0647 \u06cc \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u0628\u0644\u063a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u062f\u0631\u06af\u0627\u0647 \u0633\u0627\u06cc\u062a \u0645\u0628\u062f\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u0646\u0645\u0627\u06cc\u06cc\u062f."},CRYPTO:{WITH_CRYPTO:"\u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u0631\u0632 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644",WIDOE_GUIDE:"\u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u0648\u06cc\u062f\u06cc\u0648\u06cc\u06cc",CURRENCY_TYPE:"\u0646\u0648\u0639 \u0627\u0631\u0632",SELECT_NETWORK:"\u0634\u0628\u06a9\u0647 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f",CONTROL_ADDRESS:"\u0622\u062f\u0631\u0633 \u0648\u0627\u0631\u06cc\u0632\u06cc \u062e\u0648\u062f \u0631\u0627 \u0631\u0627 \u0628\u0647 \u062f\u0642\u062a \u06a9\u0646\u062a\u0631\u0644 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0622\u062f\u0631\u0633 \u0646\u0627\u062f\u0631\u0633\u062a\u060c \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0627\u0631\u0627\u06cc\u06cc \u0634\u0645\u0627 \u063a\u06cc\u0631 \u0642\u0627\u0628\u0644 \u062f\u0633\u062a\u0631\u0633 \u0634\u0648\u062f.",DIRECT_DEPOSIT:"\u0627\u0632 \u0648\u0627\u0631\u06cc\u0632 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0627\u0632 \u0635\u0631\u0627\u0641\u06cc\u200c\u0647\u0627\u06cc \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc\u060c \u0628\u0647\u200c \u062e\u0635\u0648\u0635 \u0635\u0631\u0627\u0641\u06cc\u200c\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f CoinBase \u0648 Kraken \u06a9\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0627\u06cc\u0631\u0627\u0646\u06cc \u0631\u0627 \u0645\u062d\u062f\u0648\u062f \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u060c \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0627\u0632 \u06a9\u06cc\u0641\u200c\u067e\u0648\u0644 \u0634\u062e\u0635\u06cc\u060c \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u06cc\u06a9\u200c\u0628\u0627\u0631 \u0645\u0635\u0631\u0641 \u0648 \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u0627\u0646\u062a\u0642\u0627\u0644 \u0686\u0646\u062f \u0644\u0627\u06cc\u0647 \u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0627\u0645\u0646\u06cc\u062a \u062f\u0627\u0631\u0627\u06cc\u06cc\u200c\u0647\u0627\u06cc\u062a\u0627\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.",DEPOSIT_ADDRESS:"\u0622\u062f\u0631\u0633 \u0648\u0627\u0631\u06cc\u0632 \u062a\u062a\u0631",ASSETS_SECURITY:"\u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0627\u0645\u0646\u06cc\u062a \u062f\u0627\u0631\u0627\u06cc\u06cc\u200c\u0647\u0627\u06cc\u062a\u0627\u0646\u060c \u0644\u0637\u0641\u0627 \u0641\u0642\u0637 \u062a\u062a\u0631 \u0631\u0627 \u0628\u0647 \u0627\u06cc\u0646 \u0622\u062f\u0631\u0633 \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u06cc\u062f. \u0648\u0627\u0631\u06cc\u0632 \u0647\u0631 \u0627\u0631\u0632 \u062f\u06cc\u06af\u0631\u06cc \u0628\u0647 \u0627\u06cc\u0646 \u0622\u062f\u0631\u0633 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a
0638\u0629 \u0623\u0646\u0647 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0623\u0645\u0627\u0646 \u062d\u0633\u0627\u0628 TC \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0648\u062a\u062d\u0633\u064a\u0646\u0647\u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0623\u0648\u0644\u0627\u064b \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u062a\u062d\u0642\u0642 \u0639\u0628\u0631 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0627\u0644\u0647\u0627\u062a\u0641\u064a\u0629 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629. \u064a\u0631\u062c\u0649 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0632\u0631 \u0623\u062f\u0646\u0627\u0647 \u0644\u062a\u0644\u0642\u064a \u0645\u0643\u0627\u0644\u0645\u0629 \u0647\u0627\u062a\u0641\u064a\u0629 \u0645\u0646 \u0623\u062d\u062f \u0645\u0633\u0624\u0648\u0644\u064a\u0646\u0627. \u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u0625\u0630\u0627 \u0644\u0645 \u062a\u0631\u062f \u0639\u0644\u0649 \u0645\u0643\u0627\u0644\u0645\u0629 \u062e\u0628\u0631\u0627\u0626\u0646\u0627\u060c \u0641\u0644\u0646 \u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0625\u0639\u0627\u062f\u0629 \u062a\u0642\u062f\u064a\u0645 \u0637\u0644\u0628 \u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0647\u0627\u062a\u0641\u064a\u0629 \u062e\u0644\u0627\u0644 3 \u0633\u0627\u0639\u0627\u062a.",PHONECALL_INTERVIEW_DESCRIPTION1:"1. \u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0643 \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0625\u062c\u0631\u0627\u0621 \u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0639\u0628\u0631 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0627\u0644\u0647\u0627\u062a\u0641\u064a\u0629 \u0641\u0642\u0637 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0646\u0648\u064a \u062a\u0642\u062f\u064a\u0645 \u0623\u064a \u0645\u0646 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061b \u0648\u0625\u0644\u0627\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u062e\u0637\u064a \u0647\u0630\u0647 \u0627\u0644\u062e\u0637\u0648\u0629 \u0641\u064a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642.",ADDRESS_DESCRIPTION1:"2. \u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0643 \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0625\u062c\u0631\u0627\u0621 \u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0641\u0642\u0637 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0646\u0648\u064a \u062a\u0642\u062f\u064a\u0645 \u0623\u064a \u0645\u0646 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061b \u0648\u0625\u0644\u0627\u060c \u064a\u0645\u0643\u0646\u0643 \u062a\u062e\u0637\u064a \u0647\u0630\u0647 \u0627\u0644\u062e\u0637\u0648\u0629 \u0641\u064a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642.",PHONECALL_INTERVIEW_DESCRIPTION2:"3. \u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u0641\u064a \u062d\u0627\u0644\u0629 \u0639\u062f\u0645 \u0627\u0644\u0631\u062f \u0639\u0644\u0649 \u0645\u0643\u0627\u0644\u0645\u0629 \u062e\u0628\u0631\u0627\u0626\u0646\u0627 \u0644\u0645\u062f\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 3 \u0633\u0627\u0639\u0627\u062a\u060c \u0641\u0644\u0646 \u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u062a\u0633\u062c\u064a\u0644 \u0637\u0644\u0628 \u0644\u0645\u0642\u0627\u0628\u0644\u0629 \u0647\u0627\u062a\u0641\u064a\u0629.",CALL_ME:"\u0627\u062a\u0635\u0644 \u0628\u064a!",RETRY_CALL_DIALOG_TEXT:'\u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0623\u0648\u0644\u0627\u064b \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u062a\u062d\u0642\u0642 \u0639\u0628\u0631 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0627\u0644\u0647\u0627\u062a\u0641\u064a\u0629 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629. \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0641\u0648\u0642 \u0627\u0644\u0632\u0631 "\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649" \u0644\u0625\u062a\u0645\u0627\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629.1',WAITING_FOR_PHONECALL:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0637\u0644\u0628\u0643 \u0648\u0633\u064a\u0642\u0648\u0645 \u062e\u0628\u0631\u0627\u0624\u0646\u0627 \u0628\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0643 \u062e\u0644\u0627\u0644 \u0633\u0627\u0639\u062a\u064a\u0646. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0644\u064a \u0628\u0627\u0644\u0635\u0628\u0631.",PHONECALL_INTERVIEW_DONE:"\u0644\u0642\u062f \u0627\u062c\u062a\u0632\u062a \u0645\u0642\u0627\u0628\u0644\u0629 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0629 \u0627\u0644\u0647\u0627\u062a\u0641\u064a\u0629 \u0628\u0646\u062c\u0627\u062d!",PHONECALL_INTERVIEW_REJECTED:"\u062a\u0645 \u0631\u0641\u0636 \u0637\u0644\u0628\u0643",PHONECALL_INTERVIEW_CONFIRM_DES:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u064a\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646 \u0627\u0644\u062a\u062d\u0642\u0642 \u0639\u0628\u0631 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0627\u0644\u0647\u0627\u062a\u0641\u064a\u0629 \u0645\u0637\u0644\u0648\u0628 \u0641\u0642\u0637 \u0644\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u0648\u0625\u0644\u0627 \u0641\u0644\u0646 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062a\u062d\u0642\u0642:",SUPPORT:"\u0627\u0644\u062f\u0639\u0645",SUSPENDED:"\u0645\u0639\u0644\u0642",SUSPEND_ALERT:"\u0645\u062d\u0641\u0638\u0629 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643",SKIP:"\u062a\u062e\u0637\u064a",ERROR:{PASSWORD_MIN_LENGTH:"\u064a\u062c\u0628 \u0623\u0646 \u062a\u062d\u062a\u0648\u064a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0644\u0649 {{value}} \u0623\u062d\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644",PASSWORD_MAX_LENGTH:"\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0637\u0648\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0647\u0648 {{value}} \u0623\u062d\u0631\u0641",PASSWORD_IS_NOT_SAME:"\u062a\u0623\u0643\u064a\u062f \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u064a\u062e\u062a\u0644\u0641 \u0639\u0646 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062c\u062f\u064a\u062f\u0629."},REQUESTS_TYPE:{DEPOSIT_E_MONEY:"\u0627\u0644\u0625\u064a\u062f\u0627\u0639 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u062d\u0644\u064a",DEPOSIT_MONEY_CURRENCY:"\u0627\u0644\u0625\u064a\u062f\u0627\u0639 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",EXCHANGE_MONEY_CURRENCY:"\u0627\u0644\u062a\u0628\u0627\u062f\u0644 (\u0645\u062d\u0641\u0638\u0629 TC)",WITHDRAWAL_POINT:"\u0646\u0642\u0637\u0629 \u0627\u0644\u0633\u062d\u0628",SEND_E_MONEY:"\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",SEND_TC_WALLET:"\u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0645\u0646 \u0645\u062d\u0641\u0638\u0629 TC",SEND_MONEY_CURRENCY:"\u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u062d\u0644\u064a",VOUCHER:"\u0634\u0631\u0627\u0621 \u0642\u0633\u064a\u0645\u0629",WITHDRAWAL_E_MONEY:"\u0627\u0644\u0633\u062d\u0628 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",WITHDRAWAL_MONEY_CURRENCY:"\u0627\u0644\u0633\u062d\u0628 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0645\u062d\u0644\u064a"},VERIFY:{VERIFY:"\u0627\u0644\u062a\u062d\u0642\u0642",REQUIRED:"\u0645\u0637\u0644\u0648\u0628",OPTIONAL:"\u0627\u062e\u062a\u064a\u0627\u0631\u064a",TYPE:{ADDRESS:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0639\u0646\u0648\u0627\u0646",PERSONAL:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",PERSONAL_IDENTITY:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",PERSONAL_PASSPORT:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",DRIVER_LICENSE:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",PHOTO_UPLOAD:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0635\u0648\u0631\u0629",PHOTO_CAMERA:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0635\u0648\u0631\u0629",PHOTO:"\u0635\u0648\u0631\u0629"},NOTIFY:{TITLE:{VERIFY_INFO:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a"},NOTIFICATION:{BODY:{ACCEPTED:"\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 {{0}}.",REJECTED:"\u062a\u0645 \u0631\u0641\u0636 {{0}}."}},KYC:{NOTIFICATION:{TITLE:{ACCEPTED:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 (KYC)",REJECTED:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 (KYC)"},BODY:{REJECTED:"\u062a\u0645 \u0631\u0641\u0636 \u0647\u0648\u064a\u062a\u0643 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645.",ACCEPTED:"\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0647\u0648\u064a\u062a\u0643 \u0628\u0646\u062c\u0627\u062d \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645."}}}},KYC:{INFORMATION:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a",ENTER_TO_KYC:"\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 (KYC)",IRANIAN_USERS_CONFIRM_ALERT:"\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u062a\u064a \u0623\u0635\u062f\u0631\u062a \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u0643 \u0647\u064a \u0625\u064a\u0631\u0627\u0646\u060c \u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0627\u0633\u0645\u0643 \u0648\u0644\u0642\u0628\u0643 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0641\u0627\u0631\u0633\u064a\u0629.",DESCRIPTION:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0645\u0646 \u0623\u062c\u0644 \u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0623\u0645\u0627\u0646 \u0648\u0645\u0646\u0639 \u0623\u064a \u0627\u0646\u062a\u0647\u0627\u0643\u0627\u062a \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u062d\u062a\u0627\u0644\u064a\u0646\u060c \u064a\u0631\u062c\u0649 \u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643",ALERT_ERROR:"\u0644\u0644\u0623\u0633\u0641\u060c \u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645",ALERT_DONE:"\u062a\u0645 \u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0628\u0646\u062c\u0627\u062d.",ALERT_WAITING:"\u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\
\u0627\u0645\u06cc \u0645\u06cc \u0628\u0627\u0634\u062f. \u0628\u062f\u06cc\u0646 \u0645\u0646\u0638\u0648\u0631 \u0644\u0637\u0641\u0627 \u0628\u0631 \u0631\u0648\u06cc \u06af\u0632\u06cc\u0646\u0647 \u062a\u0644\u0627\u0634 \u0645\u062c\u062f\u062f \u06a9\u0644\u06cc\u06a9 \u0646\u0645\u0627\u06cc\u06cc\u062f.",WAITING_FOR_PHONECALL:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648 \u062f\u0631 \u0645\u062f\u062a \u0632\u0645\u0627\u0646 2 \u0633\u0627\u0639\u062a \u0628\u0627 \u0634\u0645\u0627 \u062a\u0645\u0627\u0633 \u062d\u0627\u0635\u0644 \u0645\u06cc\u06af\u0631\u062f\u062f \u0644\u0637\u0641\u0627 \u0635\u0628\u0648\u0631 \u0628\u0627\u0634\u06cc\u062f.",PHONECALL_INTERVIEW_DONE:"\u0634\u0645\u0627 \u0645\u0635\u0627\u062d\u0628\u0647 \u062a\u0644\u0641\u0646\u06cc \u0631\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u06af\u0630\u0631\u0627\u0646\u062f\u0647 \u0627\u06cc\u062f!",PHONECALL_INTERVIEW_REJECTED:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0631\u062f \u0634\u062f",PHONECALL_INTERVIEW_CONFIRM_DES:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u062a\u0627\u06cc\u06cc\u062f \u062a\u0645\u0627\u0633 \u0647\u0627\u06cc \u062a\u0644\u0641\u0646\u06cc \u0641\u0642\u0637 \u0628\u0631\u0627\u06cc \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0627\u0644\u0632\u0627\u0645\u06cc \u0627\u0633\u062a \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u0627\u0646\u062c\u0627\u0645 \u0627\u06cc\u0646 \u062a\u0627\u06cc\u06cc\u062f \u0646\u062e\u0648\u0627\u0647\u06cc\u062f \u062f\u0627\u0634\u062a",SUPPORT:"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc",SUSPENDED:"\u0645\u0639\u0644\u0642 \u0634\u062f\u0647",SUSPEND_ALERT:"\u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0634\u0645\u0627 \u0645\u0633\u062f\u0648\u062f \u0634\u062f.",SKIP:"\u0631\u062f \u06a9\u0631\u062f\u0646",REQUESTS_TYPE:{DEPOSIT_E_MONEY:"\u0634\u0627\u0631\u0698 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u062d\u0644\u06cc",DEPOSIT_MONEY_CURRENCY:"\u0634\u0627\u0631\u0698 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0648\u0644 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9",EXCHANGE_MONEY_CURRENCY:"\u062a\u0628\u062f\u06cc\u0644(\u067e\u0631\u062f\u0627\u062e\u062a \u0645\u062d\u0644\u06cc)",WITHDRAWAL_POINT:"\u0628\u0631\u062f\u0627\u0634\u062a \u0627\u0645\u062a\u06cc\u0627\u0632",SEND_MONEY_CURRENCY:"\u0627\u0631\u0633\u0627\u0644 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u062d\u0644\u06cc",SEND_TC_WALLET:"\u0627\u0631\u0633\u0627\u0644 \u0627\u0632 \u06a9\u06cc\u0641 \u067e\u0648\u0644",SEND_E_MONEY:"\u0627\u0631\u0633\u0627\u0644 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0648\u0644 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9",VOUCHER:"\u062e\u0631\u06cc\u062f \u0648\u0648\u0686\u0631",WITHDRAWAL_E_MONEY:"\u0628\u0631\u062f\u0627\u0634\u062a \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0648\u0644 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9",WITHDRAWAL_MONEY_CURRENCY:"\u0628\u0631\u062f\u0627\u0634\u062a \u0627\u0632 \u0637\u0631\u06cc\u0642 \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u062d\u0644\u06cc"},VERIFY:{VERIFY:"\u062a\u0627\u06cc\u06cc\u062f",REQUIRED:"\u0627\u062c\u0628\u0627\u0631\u06cc",OPTIONAL:"\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc",TYPE:{ADDRESS:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0622\u062f\u0631\u0633",PERSONAL:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc",PERSONAL_IDENTITY:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc",PERSONAL_PASSPORT:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc",DRIVER_LICENSE:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc",PHOTO_UPLOAD:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0639\u06a9\u0633",PHOTO_CAMERA:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0639\u06a9\u0633",PHOTO:"\u0639\u06a9\u0633"},NOTIFY:{TITLE:{VERIFY_INFO:"\u062a\u0627\u06cc\u06cc\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a"},NOTIFICATION:{BODY:{ACCEPTED:"{{0}} \u0634\u0645\u0627 \u062a\u0627\u06cc\u06cc\u062f \u0634\u062f.",REJECTED:"{{0}} \u0634\u0645\u0627 \u0631\u062f \u0634\u062f."}},KYC:{NOTIFICATION:{TITLE:{ACCEPTED:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a",REJECTED:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a"},BODY:{REJECTED:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0631\u062f \u0634\u062f.",ACCEPTED:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062a\u0623\u06cc\u06cc\u062f \u0634\u062f."}}}},KYC:{INFORMATION:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a",ENTER_TO_KYC:"\u0648\u0627\u0631\u062f KYC \u0634\u0648\u06cc\u062f",IRANIAN_USERS_CONFIRM_ALERT:"\u0644\u0637\u0641\u0627 \u0627\u06af\u0631 \u0645\u062f\u0627\u0631\u06a9 \u0627\u0631\u0633\u0627\u0644\u06cc \u0634\u0645\u0627 \u0635\u0627\u062f\u0631\u0647 \u0627\u0632 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc \u0628\u0627\u0634\u062f \u062d\u062a\u0645\u0627 \u0645\u0634\u062e\u0635\u0627\u062a \u062e\u0648\u062f (\u0646\u0627\u0645 - \u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc) \u0631\u0627 \u0628\u0647 \u0641\u0627\u0631\u0633\u06cc \u0648\u0627\u0631\u062f \u0646\u0645\u0627\u06cc\u06cc\u062f.",DESCRIPTION:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u0644\u0637\u0641\u0627 \u062c\u0647\u062a \u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u0645\u0646\u06cc\u062a \u0648 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0647\u0631\u06af\u0648\u0646\u0647 \u062a\u062e\u0644\u0641 \u0633\u0648\u062f\u062c\u0648\u06cc\u0627\u0646\u0647 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f",ALERT_ERROR:"\u0645\u062a\u0623\u0633\u0641\u0627\u0646\u0647 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f\u060c \u0644\u0637\u0641\u0627\u064b \u0628\u0627 \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f",ALERT_DONE:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a.",ALERT_WAITING:"\u062f\u0631 \u062d\u0627\u0644 \u062a\u06a9\u0645\u06cc\u0644 \u067e\u0631\u0648\u0633\u0647 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a ..."},LETTER_OF_COMMITMENT:{ALERT_DONE:"\u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u0639\u0647\u062f \u0646\u0627\u0645\u0647 \u062e\u0648\u062f \u0631\u0627 \u0627\u0631\u0633\u0627\u0644 \u0646\u0645\u0648\u062f\u0647 \u0627\u06cc\u062f.",ALERT_MISS_MATCH_DATA:"\u0645\u062a\u0623\u0633\u0641\u0627\u0646\u0647 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0634\u06a9\u0644 \u0645\u0648\u0627\u062c\u0647\u060c \u0644\u0637\u0641\u0627\u064b \u0628\u0627 \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f.",TEXT:"\u0627\u06cc\u0646\u062c\u0627\u0646\u0628 <strong>{{name}}</strong> \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 \u0645\u0644\u06cc <strong>{{code}}</strong> \u0645\u062f\u0627\u0631\u06a9 \u062e\u0648\u062f \u0631\u0627 \u062c\u0647\u062a \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062f\u0631 \u0633\u0627\u06cc\u062a (Top Change) \u0627\u0631\u0633\u0627\u0644 \u06a9\u0631\u062f\u0647 \u0627\u0645 \u0648 \u0628\u0627 \u0622\u06af\u0627\u0647\u06cc \u06a9\u0627\u0645\u0644 \u062a\u0635\u062f\u06cc\u0642 \u0645\u06cc \u06a9\u0646\u0645 \u06a9\u0647 \u062b\u0628\u062a \u0646\u0627\u0645 \u062a\u0648\u0633\u0637 \u0627\u06cc\u0646\u062c\u0627\u0646\u0628 \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648 \u0645\u062f\u0627\u0631\u06a9 \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0634\u062e\u0635\u06cc \u062f\u06cc\u06af\u0631 \u0642\u0631\u0627\u0631 \u0646\u062f\u0627\u062f\u0647 \u0627\u0645. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u062a\u0639\u0647\u062f \u0645\u06cc \u0634\u0648\u0645 \u0627\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u0648\u0644 \u0646\u0642\u062f \u0648 \u0627\u0631\u0632 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0628\u0647 \u0647\u0631 \u0634\u06a9\u0644\u06cc \u062f\u0631 \u0627\u0632\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0627\u0645 \u062a\u0648\u0633\u0637 \u0627\u0641\u0631\u0627\u062f \u062f\u06cc\u06af\u0631 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u0645. \u0627\u06cc\u0646\u062c\u0627\u0646\u0628 \u062a\u0627\u06cc\u06cc\u062f \u0645\u06cc \u06a9\u0646\u0645 \u06a9\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0634\u062e\u0635 \u062f\u06cc\u06af\u0631\u06cc \u0642\u0631\u0627\u0631 \u0646\u062f\u0627\u062f\u0647 \u0627\u0645 \u0648 \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u0633\u067e\u0631\u062f\u0647 \u063a\u06cc\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u0648 \u0642\u0636\u0627\u06cc\u06cc \u0622\u0646 \u0627\u0632 \u062c\u0645\u0644\u0647 \u0645\u062c\u0627\u0632\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u0648 \u062c\u0628\u0631\u0627\u0646 \u062e\u0633\u0627\u0631\u062a \u0634\u0627\u06a9\u06cc \u0628\u0631 \u0639\u0647\u062f\u0647 \u0628\u0646\u062f\u0647 \u0627\u0633\u062a.",CONFIRM_CHECKBOX:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0641\u0648\u0642 \u0631\u0627 \u062a\u0627\u06cc\u06cc\u062f \u0645\u06cc \u0646\u0645\u0627\u06cc\u0645",MISS_MATCH_DATA:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u062a\u0646\u0627\u0642\u0636"}},ERROR:{PASSWORD_IS_NOT_SAME:"\u062a\u0627\u06cc\u06cc\u062f \u0631\u0645\u0632 \u062c\u062f\u06cc\u062f \u0628\u0627 \u0631\u0645\u0632 \u062c\u062f\u06cc\u062f \u0645\u062a\u0641\u0627\u0648\u062a \u0627\u0633\u062a"},TAKE_PIC_DESCRIPTION:'\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u062c\u0647\u062a \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0647\u0631 \u06af\u0648\u0646\u0647 \u062a\u062e\u0644\u0641\u0627\u062a \u0648 \u062d\u0641\u0638 \u0627\u0645\u0646\u06cc\u062a \u062a\u0631\u0627\u06a9\u0646\u0634 \u0647\u0627 \u0639\u06a9\u0633 \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u0645\u0634\u062e\u0635\u0627\u062a \u0632\u06cc\u0631 \u0628\u0631\u0627\u06cc \u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u0646\u0645\u0627\u06cc\u06cc\u062f.<br/>* \u062a\u0645\u0627\u0645\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0631\u0627 \u0628\u0627 \u062e\u0648\u062f\u06a9\u0627\u0631\u0622\u0628\u06cc \u0628\u0631 \u0631\u0648\u06cc \u06a9\u0627\u063a\u0630 \u0633\u0641\u06cc\u062f \u0646\u0648\u0634\u062a\u0647 \u0634\u0648\u062f.<br/>* \u062d\u062c\u0645 \u0639\u06a9\u0633 \u06a9\u0645\u062a\u0631 \u0627\u0632 2 \u0645\u06af\u0627\u0628\u0627\u06cc\u062a \u0628\u0627\u0634\u062f.<br/> <div class="title">\u06f1- \u0628\u0631\u06af\u0647 \u0633\u0641\u06cc\u062f</div> \u06cc\u06a9 \u0628\u0631\u06af\u0647 \u0633\u0641\u06cc\u062f \u0631\u0627 \u0628\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0634\u062e\u0635 \u0634\u062f\u0647 \u062f\u0631 \u062a\u0635\u0648\u06cc\u0631 \u0645\u0642\u0627\u0628\u0644 \u062e\u0648\u062f \u0628\u06af\u06cc\u0631\u06cc\u062f.<br/> <div class="title">\u06f2- \u0686\u0633\u0628\u0627\u0646\u062f\u0646 \u06a9\u0627\u0631\u062a \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc</div> \u06a9\u0627\u0631\u062a \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u062e\u0648\u062f \u0631\u0627 \u0647\u0645\u0627\u0646\u0646\u062f \u0622\u0646\u0686\u0647 \u062f\u0631 \u062a\u0635\u0648\u06cc\u0631 \u0645\u06cc\u0628\u06cc\u0646\u06cc\u062f \u0628\u0647 \u0628\u0631\u06af\u0647 \u0628\u0686\u0633\u0628\u0627\u0646\u06cc\u062f.<br/> <div class="title">\u06f3- \u0646\u0648\u0634\u062a\u0646 \u06a9\u062f</div> \u06a9\u062f \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u062f\u0631 \u0641\u0631\u0645 \u0632\u06cc\u0631 \u0628\u0627 \u062f\u0633\u062a \u062e\u0637 \u062e\u0648\u062f\u062a\u0627\u0646 \u062f\u0631 \u0628\u0631\u06af\u0647 \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f.<br/> <div class="title">\u06f4- \u0646\u0648\u0634\u062a\u0646 \u0645\u062a\u0646</div> \u0627\u06cc\u0646\u062c\u0627\u0646\u0628 ...... \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 \u0645\u0644\u06cc ...... \u062f\u0631 \u062a\u0627\u0631\u06cc\u062e ......\u0645\u062f\u0627\u0631\u06a9 \u062e\u0648\u062f \u0631\u0627 \u062c\u0647\u062a \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062f\u0631 \u0633\u0627\u06cc\u062a \u062a\u0627\u067e \u0686\u0646\u062c \u0627\u0631\u0633\u0627\u0644 \u06a9\u0631\u062f\u0647 \u0648 \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u062f\u06cc\u06af\u0631\u06cc \u0642\u0631\u0627\u0631 \u0646\u062f\u0627\u062f\u0647\u200c\u0627\u0645 \u0648 \u0645\u062a\u0639\u0647\u062f \u0645\u06cc\u200c\u0634\u0648\u0645 \u0627\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u0648\u062c\u0647 \u0648 \u062e\u0631\u06cc\u062f \u0627\u0631\u0632 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0628\u0631\u0627\u06cc \u0627\u0634\u062e\u0627\u0635 \u062f\u06cc\u06af\u0631\u06cc \u062a\u062d\u062a \u0647\u0631 \u0639\u0646\u0648\u0627\u0646\u06cc \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u0645 \u0648 \u0647\u0631\u06af\u0648\u0646\u0647 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u067e\u06cc\u06af\u0631\u062f \u062d\u0642\u0648\u0642\u06cc \u0648 \u0642\u0636\u0627\u06cc\u06cc \u0627\u06cc\u0646 \u0645\u0648\u0627\u0631\u062f \u0631\u0627 \u0628\u067e\u0630\u06cc\u0631\u0645.<br/> <div class="title">\u06f5- \u0627\u0645\u0636\u0627</div> \u0627\u0645\u0636\u0627\u06cc \u0634\u0645\u0627.',ALERT:{PASSWORD_CHANGED_SUCCESSFULLY:"\u06a9\u0644\u0645\u0647 \u0639\u0628\u0648\u0631 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u063a\u06cc\u06cc\u0631 \u06cc\u0627\u0641\u062a! \u0644\u0637\u0641\u0627 \u0645\u062c\u062f\u062f\u0627 \u0628\u0647 \u0633\u06cc\u0633\u062a\u0645 \u0648\u0627\u0631\u062f \u0634\u0648\u06cc\u062f",MOBILE_NUMBER_HAS_BEEN_VERIFIED:"\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u0627\u06cc\u06cc\u062f \u0634\u062f",MOBILE_NUMBER_HAS_BEEN_SUCCESSFULLY_REGISTRED:"\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u0634\u062f",PEERSONAL_INFO_HAS_BEEN_UPDATED:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0628\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06af\u0631\u062f\u06cc\u062f.",ADDRESS_HAS_BEEN_UPDATED:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0622\u062f\u0631\u0633 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0628\u0647 \u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06af\u0631\u062f\u06cc\u062f.",ERROR_PERSONAL_INFO_NOT_VERIFIED:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u062a\u0627\u06cc\u06cc\u062f \u0646\u0634\u062f\u0647 \u0627\u0633\u062a",ERROR_PERSONAL_INFO_REJECTED:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062a\u0627\u06cc\u06cc\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0631\u062f \u0634\u062f",ERROR_PHOTO_VERIFY_REJECTED:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0627\u0647\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0631\u062f \u0634\u062f",PERSONAL_INFO_SHOULD_MATCH_WITH_ID_CARD:"\u062a\u0648\u062c\u0647 : \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u0628\u0627\u06cc\u062f \u0628\u0627 \u06a9\u0627\u0631\u062a \u0645\u0644\u06cc \u0648 \u06cc\u0627 \u067e\u0627\u0633\u067e\u0648\u0631\u062a \u0634\u0645\u0627 \u0645\u0637\u0627\u0628\u0642\u062a \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f.",PERSONAL_INFO_VERIFY_IS_PENDING:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633\u0627\u0646 \u0645\u0627 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc \u0628\u0627\u0634\u062f.",ADDRESS_VERIFY_IS_PENDING:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0622\u062f\u0631\u0633 \u0634\u0645\u0627 \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633\u0627\u0646 \u0645\u0627 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc \u0628\u0627\u0634\u062f.",PHOTO_VERIFY_IS_PENDING:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0634\u0646\u0627\u0633\u0627\u0646 \u0645\u0627 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc \u0628\u0627\u0634\u062f.",PERSONAL_INFO_VERIFYED:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u0627\u06cc\u06cc\u062f \u0634\u062f\u0647 \u0627\u0633\u062a",PHOTO_VERIFY_ACCEPTED:"\u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u0627\u06cc\u06cc\u062f \u0634\u062f\u0647 \u0627\u0633\u062a.",ADDRESS_VERIFYED:"\u0622\u062f\u0631\u0633 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062a\u0627\u06cc\u06cc\u062f \u0634\u062f\u0647 \u0627\u0633\u062a",DOCUMENTS_UPLOADED:"\u0628\u0627\u0631\u06af\u0632\u0627\u0631\u06cc \u0645\u062f\u0627\u0631\u06a9 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f",ERROR_ADDRESS_INFO_REJECTED:"\u062f\u0631 \u062e\u0648\u0627\u0633\u062a \u062a\u0627\u06cc\u06cc\u062f \u0622\u062f\u0631\u0633 \u0634\u0645\u0627 \u0631\u062f \u0634\u062f.",ADDRESS_UPLOAD_HINT:"\u062a\u0648\u062c\u0647 : \u0628\u0631\u0627\u06cc \u062a\u0627\u06cc\u06cc\u062f \u0622\u062f\u0631\u0633 \u06cc\u06a9 \u0627\u0633\u06a9\u0646 \u0648\u0627\u0636\u062d \u0627\u0632 \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u062f\u0627\u0631\u06a9 \u0645\u0639\u062a\u0628\u0631 \u0645\u0627\u0646\u0646\u062f \u0642\u0628\u0636 \u0633\u0627\u0644 \u062c\u0627\u0631\u06cc (\u062a\u0644\u0641\u0646 \u062b\u0627\u0628\u062a\u060c \u0622\u0628\u060c \u0628\u0631\u0642\u060c \u06af\u0627\u0632)\u060c \u0633\u0646\u062f \u0645\u0644\u06a9 \u06cc\u0627 \u0648\u0633\u0627\u06cc\u0644 \u0646\u0642\u0644\u06cc\u0647\u060c \u0627\u062c\u0627\u0631\u0647 \u0646\u0627\u0645\u0647 \u0648 \u0628\u06cc\u0645\u0647 \u0646\u0627\u0645\u0647 \u0622\u067e\u0644\u0648\u062f \u06a9\u0646\u06cc\u062f. \n \u0628\u0631\u0627\u06cc \u062a\u0627\u06cc\u06cc\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0627\u06cc\u062f \u0627\u062f\u0631\u0633 \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0648 \u0627\u063
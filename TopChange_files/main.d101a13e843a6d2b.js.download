a \u0645\u0634\u0643\u0644\u0627\u062a \u0645\u062d\u062a\u0645\u0644\u0629.",TEXT_TWO:"\u064a\u062c\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u0634\u062a\u0631\u064a \u062a\u0648\u0636\u064a\u062d \u0634\u0631\u0648\u0637\u0647 \u0648\u062a\u0648\u0642\u0639\u0627\u062a\u0647 \u0648\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a\u0647."},RULE_SIX:{TITLE:"\u062a\u062f\u062e\u0644 \u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645",TEXT_ONE:"\u064a\u062d\u0642 \u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u062f\u0639\u0645 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u062f\u0648\u0646 \u0625\u0634\u0639\u0627\u0631 \u0645\u0633\u0628\u0642.",TEXT_TWO:"\u0641\u064a \u062d\u0627\u0644 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u064a \u0633\u0644\u0648\u0643 \u0645\u0631\u064a\u0628 \u0623\u0648 \u0645\u062e\u0627\u0644\u0641\u0627\u062a \u0623\u0648 \u0637\u0644\u0628\u0627\u062a \u063a\u064a\u0631 \u0637\u0628\u064a\u0639\u064a\u0629 \u0645\u0646 \u0623\u064a \u0637\u0631\u0641\u060c \u0642\u062f \u064a\u0642\u0648\u0645 \u0627\u0644\u062f\u0639\u0645 \u0628\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0623\u0648 \u062a\u0642\u064a\u064a\u062f\u0647\u0627 \u0623\u0648 \u0625\u0646\u0647\u0627\u0626\u0647\u0627."},INTERNAL_CHAT_ONLY:"\u064a\u062c\u0628 \u0625\u062c\u0631\u0627\u0621 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u062d\u0635\u0631\u064a\u0627\u064b \u0639\u0628\u0631 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0644\u0645\u0646\u0635\u0629.",EXTERNAL_CHANNEL_FORBIDDEN:"\u064a\u064f\u062d\u0638\u0631 \u0646\u0642\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0625\u0644\u0649 \u0623\u064a \u0642\u0646\u0627\u0629 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0646\u0635\u0629 \u0648\u0644\u0646 \u062a\u064f\u0639\u062a\u0628\u0631 \u0635\u0627\u0644\u062d\u0629 \u0641\u064a \u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u0646\u0632\u0627\u0639\u0627\u062a.",CONTACT_SHARING_FORBIDDEN:"\u064a\u064f\u0645\u0646\u0639 \u0645\u0646\u0639\u0627\u064b \u0628\u0627\u062a\u0627\u064b \u0645\u0634\u0627\u0631\u0643\u0629 \u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0623\u0648 \u0645\u0639\u0631\u0641\u0627\u062a \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0623\u0648 \u0646\u0642\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0646\u0635\u0629.",UNPROFESSIONAL_MESSAGE_WARNING:"\u062a\u062c\u0646\u0628 \u0625\u0631\u0633\u0627\u0644 \u0631\u0633\u0627\u0626\u0644 \u063a\u064a\u0631 \u0645\u0647\u0646\u064a\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0639\u064a\u0627\u0631\u064a\u0629\u060c \u0623\u0648 \u0637\u0644\u0628 \u062a\u063a\u064a\u064a\u0631 \u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629.",DISPUTE_EVIDENCE_POLICY:"\u0641\u064a \u062d\u0627\u0644 \u0646\u0634\u0648\u0621 \u0646\u0632\u0627\u0639\u060c \u062a\u064f\u0639\u062f\u0651 \u0641\u0642\u0637 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0641\u064a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0644\u0645\u0646\u0635\u0629 \u0623\u0633\u0627\u0633\u0627\u064b \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0648\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631."},REPORT_VIOLATION:"\u0627\u0644\u0625\u0628\u0644\u0627\u063a",CONVERSATION_BLOCKED:"\u062a\u0645 \u062d\u0638\u0631 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u06
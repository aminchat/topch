"\u062a\u0639\u062f\u064a\u0644 \u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641",CONTINUE:"\u0645\u062a\u0627\u0628\u0639\u0629"}},PRICE_TOLERANCE_VALIDATION_FAILED:"\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u064f\u062f\u062e\u0644 \u064a\u062e\u062a\u0644\u0641 \u0628\u0634\u0643\u0644 \u0643\u0628\u064a\u0631 \u0639\u0646 \u0633\u0639\u0631 \u0627\u0644\u0633\u0648\u0642. \u064a\u0631\u062c\u0649 \u062a\u0639\u062f\u064a\u0644\u0647 \u0648\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",DIALOG_TERMS_COMMITMENT_AGREEMENT:{ALERT_TXT:"\u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0628\u0639\u0646\u0627\u064a\u0629 \u0642\u0628\u0644 \u0646\u0634\u0631 \u0627\u0644\u0625\u0639\u0644\u0627\u0646!"},ACTIVE_ORDERS_AD_VISIBILITY_WARNING:"\u0639\u0646\u062f\u0645\u0627 \u062a\u0648\u062c\u062f 4 \u0637\u0644\u0628\u0627\u062a \u0646\u0634\u0637\u0629 \u0644\u0625\u0639\u0644\u0627\u0646 \u0627\u0644\u0628\u064a\u0639 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643\u060c \u0633\u064a\u062a\u0645 \u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0625\u0639\u0644\u0627\u0646 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.",SUPPORT_REQUESTS_AD_VISIBILITY_WARNING:"\u0628\u0645\u062c\u0631\u062f \u062a\u0642\u062f\u064a\u0645 3 \u0637\u0644\u0628\u0627\u062a \u062f\u0639\u0645 \u0636\u062f \u0637\u0644\u0628\u0627\u062a\u0643\u060c \u0633\u064a\u062a\u0645 \u0625\u062e\u0641\u0627\u0621 \u062c\u0645\u064a\u0639 \u0625\u0639\u0644\u0627\u0646\u0627\u062a\u0643 \u0645\u0624\u0642\u062a\u064b\u0627.",FINAL_P2P_TRANSACTION_WARNING:"\u0645\u0639\u0627\u0645\u0644\u0627\u062a P2P \u0646\u0647\u0627\u0626\u064a\u0629. \u0642\u0628\u0644 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628\u060c \u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0628\u0644\u063a \u0648\u0627\u0644\u0633\u0639\u0631 \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062f\u0641\u0639 \u0628\u0639\u0646\u0627\u064a\u0629.",P2P_COLLATERAL_NOTICE:"\u064a\u064f\u0639\u062f \u0645\u0628\u0644\u063a \u0627\u0644\u0636\u0645\u0627\u0646 \u062a\u0639\u0647\u062f\u064b\u0627 \u0628\u0627\u0644\u062a\u0632\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0628\u0642\u0648\u0627\u0639\u062f \u0648\u0644\u0648\u0627\u0626\u062d \u062e\u062f\u0645\u0629 P2P \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0645\u0646\u0635\u0629. \u0648\u0633\u064a\u064f\u0639\u0627\u062f \u0647\u0630\u0627 \u0627\u0644\u0645\u0628\u0644\u063a \u0625\u0644\u0649 \u0645\u062d\u0641\u0638\u062a\u0643 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0625\u0639\u0644\u0627\u0646.",P2P_SERVICE_RESTRICTION_WARNING:"\u0625\u0630\u0627 \u062e\u0627\u0644\u0641\u062a \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0645\u062d\u062f\u062f\u0629\u060c \u0641\u0642\u062f \u064a\u0645\u0646\u0639\u0643 \u0627\u0644\u0645\u062e\u062a\u0635 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0645\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u062f\u0645\u0629 P2P \u0628\u0635\u0648\u0631\u0629 \u0645\u0624\u0642\u062a\u0629 \u0623\u0648 \u062f\u0627\u0626\u0645\u0629.",P2P_SEND_METHOD_PRICE_NOTICE:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u062a\u064a \u062a\u0635\u0644 \u0625\u0644\u0649 15 \u0645\u0644\u064a\u0648\u0646 \u062a\u0648\u0645\u0627\u0646\u060c \u064a\u064f\u0631\u062c\u0649 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0645\u0646 \u0628\u0637\u0627\u0642\u0629 \u0625\u0644\u0649 \u0628\u0637\u0627\u0642\u0629. \u0623\u0645\u0627 \u0644\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u062a\u064a \u062a\u0632\u064a\u062f \u0639\u0644\u0649 15 \u0645\u0644\u064a\u0648\u0646 \u062a\u0648\u0645\u0627\u0646 \u0648\u062a\u0635\u0644 \u0625\u0644\u0649 200 \u0645\u0644\u064a\u0648\u0646 \u062a\u0648\u0645\u0627\u0646\u060c \u0641\u064a\u064f\u0631\u062c\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0645\u0646 \u062d\u0633\u0627\u0628 \u0625\u0644\u0649 \u062d\u0633\u0627\u0628. \u064a\u064f\u0631\u062c\u0649 \u0645\u0644\u0627\u062d\u0638\u0629 \u0623\u0646\u0647 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u064f\u0631\u0633\u0650\u0644 \u0648\u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u0645\u064f\u0633\u062a\u0642\u0628\u0650\u0644 \u0645\u062a\u0637\u0627\u0628\u0642\u064a\u0646\u060c \u0648\u064a\u064f\u0631\u062c\u0649 \u0639\u062f\u0645 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0631\u0642\u0645 \u0627\u0644\u0622\u064a\u0628\u0627\u0646 (IBAN)."},AFFILIATE:{AFFILIATE_REQUEST:{ENTER_CODE_DESCRIPTION:"\u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u0623\u0646 \u062a\u062a\u0645 \u062f\u0639\u0648\u062a\u0643 \u0645\u0646 \u0642\u0628\u0644 \u0634\u062e\u0635 \u0622\u062e\u0631 \u0623\u062b\u0646\u0627\u0621 \u0643\u0648\u0646\u0643 \u0634\u0631\u064a\u0643\u064b\u0627 \u062a\u0627\u0628\u0639\u064b\u0627 \u0644\u062f\u064a\u0646\u0627 \u0648\u0643\u0633\u0628 \u0627\u0644\u0646\u0642\u0627\u0637 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0634\u0631\u0648\u0637 \u0627\u0644\u0634\u062e\u0635 \u0627\u0644\u0630\u064a \u062f\u0639\u0627\u0643.",ENTER_CODE:"\u0623\u062f\u062e\u0644 \u0631\u0645\u0632 \u0627\u0644\u0625\u062d\u0627\u0644\u0629",AFFILIATE_CONDITIONS:"\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645",SOCIAL_MANAGEMENT_BLOCKCHAIN:"\u0627\u0645\u062a\u0644\u0627\u0643 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062f\u064a\u0631\u0647\u0627.",ONLINE_FINANCIAL_PLATFORMS:"\u0648\u062c\u0648\u062f \u062d\u0636\u0648\u0631 \u0641\u0639\u0627\u0644 \u0639\u0644\u0649 \u0634\u0628\u0643\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0623\u0633\u0648\u0627\u0642 \u0631\u0623\u0633 \u0627\u0644\u0645\u0627\u0644 \u0645\u062b\u0644 \u064a\u0648\u062a\u064a\u0648\u0628\u060c \u062a\u0648\u064a\u062a\u0631\u060c \u0625\u0646\u0633\u062a\u062c\u0631\u0627\u0645\u060c \u0648\u062a\u0644\u064a\u062c\u0631\u0627\u0645.",COMMUNITY_EVENTS_ATTRACTION:"\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0646\u0648\u0627\u062f\u064a \u0627\u0644\u0645\u0639\u062c\u0628\u064a\u0646\u060c \u0648\u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u0627\u0644\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u0624\u062a\u0645\u0631\u0627\u062a\u060c \u0648\u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u0627\u062d\u0629 \u0625\u0639\u0644\u0627\u0646\u064a\u0629 \u0644\u062c\u0630\u0628 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u062c\u062f\u062f \u0625\u0644\u0649 \u0645\u0646\u0635\u0629 TopChange.",CONTENT_COLLABORATION_IMPACT:"\u0627\u0644\u062e\u0628\u0631\u0629 \u0648\u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u0645\u062d\u062a\u0648\u0649 \u0645\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629 \u0645\u0639 TopChange \u0648\u0627\u0644\u062a\u0623\u062b\u064a\u0631 \u0639\u0644\u0649 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062
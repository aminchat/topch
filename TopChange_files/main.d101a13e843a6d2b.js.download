NING:"\u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0648 \u063a\u06cc\u0631 \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f \u06cc\u0627 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062a\u063a\u06cc\u06cc\u0631 \u0634\u0631\u0627\u06cc\u0637 \u0645\u0639\u0627\u0645\u0644\u0647 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f.",DISPUTE_EVIDENCE_POLICY:"\u062f\u0631 \u0635\u0648\u0631\u062a \u0628\u0631\u0648\u0632 \u0627\u062e\u062a\u0644\u0627\u0641\u060c \u0641\u0642\u0637 \u0645\u062f\u0627\u0631\u06a9 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062b\u0628\u062a\u200c\u0634\u062f\u0647 \u062f\u0631 \u0686\u062a \u062f\u0627\u062e\u0644\u06cc \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u0628\u0646\u0627\u06cc \u0628\u0631\u0631\u0633\u06cc \u0648 \u062a\u0635\u0645\u06cc\u0645\u200c\u06af\u06cc\u0631\u06cc \u062e\u0648\u0627\u0647\u0646\u062f \u0628\u0648\u062f."},REPORT_VIOLATION:"\u06af\u0632\u0627\u0631\u0634 \u062a\u062e\u0644\u0641",CONVERSATION_BLOCKED:"\u06af\u0641\u062a \u0648 \u06af\u0648 \u0645\u0633\u062f\u0648\u062f \u0634\u062f\u0647",THIS_CONVERSATION_HAS_BEEN_CLOSED_BY_AN_ADMIN:"\u0627\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0647 \u062a\u0648\u0633\u0637 \u0627\u062f\u0645\u06cc\u0646 \u0628\u0633\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a.",REPORT_OF_RULE_VIOLATION:"\u06af\u0632\u0627\u0631\u0634 \u0646\u0642\u0636 \u0642\u0648\u0627\u0646\u06cc\u0646",REPORT_OF_RULE_VIOLATION_TEXT:"\u0627\u06af\u0631 \u0647\u0631\u06af\u0648\u0646\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u0645\u0634\u06a9\u0648\u06a9\u06cc \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f\u06cc\u062f\u060c \u062e\u0648\u0627\u0647\u0634\u0645\u0646\u062f\u06cc\u0645 \u06a9\u0647 \u0628\u0647 \u0633\u0631\u0639\u062a \u06a9\u0627\u0631\u0628\u0631 \u0645\u0631\u0628\u0648\u0637\u0647 \u0631\u0627 \u06af\u0632\u0627\u0631\u0634 \u062f\u0647\u06cc\u062f. \u0627\u06cc\u0646 \u0627\u0642\u062f\u0627\u0645 \u0628\u0647 \u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0628\u062a\u0648\u0627\u0646\u06cc\u0645 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0624\u062b\u0631 \u0648 \u0633\u0631\u06cc\u0639 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0644\u0627\u0632\u0645 \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u0645 \u0648 \u0627\u0645\u0646\u06cc\u062a \u0648 \u0633\u0644\u0627\u0645\u062a \u0645\u062d\u06cc\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0631\u0627 \u062d\u0641\u0638 \u06a9\u0646\u06cc\u0645. \u0647\u0645\u06a9\u0627\u0631\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0627\u06cc\u0646 \u0632\u0645\u06cc\u0646\u0647 \u0628\u0633\u06cc\u0627\u0631 \u0627\u0631\u0632\u0634\u0645\u0646\u062f \u0627\u0633\u062a.",CONFIRM:"\u062a\u0627\u06cc\u06cc\u062f",EDIT:"\u0648\u06cc\u0631\u0627\u06cc\u0634",ENTER_THE_DESCRIPTION:"\u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f...",WE_ARE_REVIEWING_YOUR_REPORT:"\u06af\u0632\u0627\u0631\u0634 \u0634\u0645\u0627 \u0642\u0628\u0644\u0627\u064b \u062f\u0631\u06cc\u0627\u0641\u062a \u0634\u062f\u0647 \u0648 \u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0627\u0633\u062a",REPORT_OF_RULE_VIOLATION_WARN:"\u06af\u0632\u0627\u0631\u0634 \u0646\u0642\u0636 \u0642\u0648\u0627\u0646\u06cc\u0646",REPORT_OF_RULE_VIOLATION_WARN_TEXT:"\u0631\u0641\u062a\u0627\u0631 \u06cc\u0627 \u0645\u062d\u062a\u0648\u0627\u06cc \u0634\u0645\u0627 \u0628\u0627 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0648 \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f\u0647\u0627\u06cc \u067e\u0644\u062a\u0641\u0631\u0645 \u0633\u0627\u0632\u06af\u0627\u0631 \u0646\u0628\u0648\u062f\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u06af\u0632\u0627\u0631\u0634 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0647 \u062f\u0644\u0627\u06cc\u0644\u06cc \u0645\u0627\u0646\u0646\u062f \u0646\u0642\u0636 \u062f\u0633\u062a\u0648\u0631\u0627\u0644\u0639\u0645\u0644\u200c\u0647\u0627\u06cc \u0627\u06cc\u0645\u0646\u06cc\u060c \u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a \u0646\u0627\u0645\u0646\u0627\u0633\u0628\u060c \u06cc\u0627 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0645\u062c\u0627\u0632 \u062b\u0628\u062a \u0634\u062f\u0647 \u0628\u0627\u0634\u062f. \u0644\u0637\u0641\u0627\u064b \u0642\u0648\u0627\u0646\u06cc\u0646 \u0631\u0627 \u0645\u0631\u0648\u0631 \u06a9\u0646\u06cc\u062f \u0648 \u062f\u0631 \u062a\u0639\u0627\u0645\u0644\u0627\u062a \u0628\u0639\u062f\u06cc \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u067e\u06cc\u0631\u0648\u06cc \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0627\u0632 \u062a\u06a9\u0631\u0627\u0631 \u0627\u06cc\u0646 \u0648\u0636\u0639\u06cc\u062a \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0634\u0648\u062f.",CONFIRM_AND_CONTINUE_CHAT:"\u062a\u0627\u06cc\u06cc\u062f \u0648 \u0627\u062f\u0627\u0645\u0647 \u0686\u062a",REASON_REPORT:{offPlatform:"\u0645\u0639\u0627\u0645\u0644\u0647 \u062e\u0627\u0631\u062c \u067e\u0644\u062a\u0641\u0631\u0645",shareContact:"\u0627\u0634\u062a\u0631\u0627\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u062a\u0645\u0627\u0633",abuse:"\u0628\u0647\u200c\u06a9\u0627\u0631\u0628\u0631\u062f\u0646 \u0632\u0628\u0627\u0646 \u062a\u0648\u0647\u06cc\u0646\u200c\u0622\u0645\u06cc\u0632",illegal:"\u0627\u0646\u062c\u0627\u0645 \u0639\u0645\u0644 \u06a9\u0644\u0627\u0647\u0628\u0631\u062f\u0627\u0631\u06cc",spam:"\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645 \u0647\u0631\u0632\u0646\u0627\u0645\u0647",threat:"\u0627\u06cc\u062c\u0627\u062f \u062a\u0647\u062f\u06cc\u062f \u06cc\u0627 \u0627\u062e\u0627\u0630\u06cc"},ALERTS:{TITLE_SUCCESSFULL_REPORT:"\u06af\u0632\u0627\u0631\u0634 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0631\u0633\u0627\u0644 \u0634\u062f.",DESCRIPTION_SUCCESSFULL_REPORT:"\u0627\u0632 \u0634\u0645\u0627 \u0628\u0627\u0628\u062a \u0627\u0642\u062f\u0627\u0645\u200c\u062a\u0627\u0646 \u0633\u067e\u0627\u0633\u06af\u0632\u0627\u0631\u06cc\u0645. \u0645\u062a\u062e\u0635\u0635\u0627\u0646 \u0645\u0627 \u062f\u0631\u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u06af\u0632\u0627\u0631\u0634 \u0634\u0645\u0627 \u0647\u0633\u062a\u0646\u062f."}}},ADV_BANNER:{ADV_BANNER_BANNER:"\u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u062a\u06cc \u0633\u06cc \u0628\u0647 \u0634\u0645\u0627"},CRYPTO_DEPOSIT:{DIALOG_ALERT:{TITLE_CHANGE_ADDRESS:"\u062a\u063a\u06cc\u06cc\u0631 \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u0648\u0627\u0631\u06cc\u0632 \u062a\u062a\u0631",BIG_DESCRIPTION_CHANGE_ADDRESS:"\u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u0648\u0627\u0631\u06cc\u0632 \u062a\u062a\u0631 \u0634\u0645\u0627 \u0627\u0632 3 \u0641\u0648\u0631\u06cc\u0647 (15 \u0628\u0647\u0645\u0646) \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.",TEXT_ONE:"\u0627\u0632 \u0627\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e:",TEXT_TWO:"\u0641\u0642\u0637 \u0627\u0632 \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u062f\u0631 \u0647\u0645\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.",TEXT_THREE:"\u0648\u0627\u0631\u06cc\u0632 \u0628\u0647 \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",GOT_IT:"\u0645\u062a\u0648\u062c\u0647 \u0634\u062f\u0645"},NOTIFY:{NOTIFICATION:{TITLE:{CRYPTO_DEPOSIT:"\u062f\u0631\u06cc\u0627\u0641\u062a (\u06a9\u06cc\u0641 \u067e\u0648\u0644)"},BODY:{CRYPTO_DEPOSIT:'\u0645\u0628\u0644\u063a <span class="fa-number-dir">&rlm;{{0}}</span> \u062f\u0631\u0634\u0628\u06a9\u0647 <span>{{
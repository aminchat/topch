u062b\u0628\u062a \u0646\u0627\u0645 \u0648 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062f\u0631 \u0633\u0627\u06cc\u062a GreenChange \u0646\u062e\u0648\u0627\u0647\u0646\u062f \u062f\u0627\u0634\u062a. \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u06cc \u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062e\u0648\u062f \u0628\u0631 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0641\u06cc\u0627\u062a \u062f\u0631 TopChange \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u0646\u062f \u0648\u0644\u06cc\u06a9\u0646 \u0645\u06cc \u0628\u0627\u06cc\u0633\u062a \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0642\u0627\u0644 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u0627\u0631\u0632 \u0628\u0647 GreenChange\u060c \u0645\u0628\u0627\u062f\u0644\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u062e\u0635\u0648\u0635 \u0631\u0645\u0632 \u0627\u0631\u0632\u0647\u0627 \u062f\u0631 \u0648\u0628\u0633\u0627\u06cc\u062a GreenChange \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u0646\u062f.",ITEM1:"\u0648\u0627\u0631\u06cc\u0632 \u0648 \u0628\u0631\u062f\u0627\u0634\u062a \u0631\u0645\u0632 \u0627\u0631\u0632\u0647\u0627 \u0628\u0647 \u0631\u0648\u0634 \u0627\u062a\u0648\u0645\u0627\u062a\u06cc\u06a9",ITEM2:"\u0627\u0641\u0632\u0627\u06cc\u0634 \u0627\u0645\u0646\u06cc\u062a \u062a\u0631\u0627\u06a9\u0646\u0634 \u0647\u0627",ITEM3:"\u0627\u0641\u0632\u0648\u062f\u0646 \u062e\u062f\u0645\u0627\u062a \u0628\u06cc\u0634\u062a\u0631 \u062f\u0631 \u062d\u0648\u0632\u0647 \u0631\u0645\u0632\u0627\u0631\u0632"},NEW_CHANGES:{TITLE:"\u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u062c\u062f\u06cc\u062f \u0631\u0645\u0632\u0627\u0631\u0632\u0647\u0627 \u062f\u0631 \u0633\u0627\u06cc\u062a TopChange",BUY:{TITLE:"\u062e\u0631\u06cc\u062f \u0631\u0645\u0632\u0627\u0631\u0632",PRE_DESCRIPTION:"\u0634\u0627\u0631\u0698 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0647\u0627\u06cc \u0631\u0645\u0632\u06
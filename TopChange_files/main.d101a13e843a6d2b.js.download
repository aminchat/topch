1\u043b\u0443\u0447\u0430\u0435 \u0435\u0441\u043b\u0438 \u0412\u044b \u0437\u0430\u0445\u043e\u0442\u0438\u0442\u0435 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0438 \u0441\u0430\u0439\u0442\u0430 \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u043e\u0431\u044a\u0451\u043c\u0435, \u0412\u044b \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0435\u0440\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0430\u0434\u0440\u0435\u0441.",ADDRESS_IS_OPTIONAL:"\u0427\u0442\u043e\u0431\u044b \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0435\u0440\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u044c, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0432\u043d\u0430\u0447\u0430\u043b\u0435 \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0431\u043b\u0430\u043d\u043a \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u0412\u0430\u0448\u0435\u043c \u0430\u0434\u0440\u0435\u0441\u0435 \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u044f.",PASSWORD_MIN_LENGTH:"\u041f\u0430\u0440\u043e\u043b\u044c \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043c\u0438\u043d\u0438\u043c\u0443\u043c {{value}} \u0437\u043d\u0430\u043a\u043e\u0432.",PASSWORD_MAX_LENGTH:"\u041f\u0430\u0440\u043e\u043b\u044c \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c {{value}} \u0437\u043d\u0430\u043a\u043e\u0432."}},NOTIFICATION:{TITLE:"\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435",NOTIFICATIONS:"\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u044f",DESCRIPTION:"\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435",EMPTY:"\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u
627\u0646\u062c\u0627\u0645 \u0646\u0645\u06cc \xad\u0634\u0648\u062f.\n\u062f\u0631 \u0646\u0638\u0631 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f\u060c \u067e\u0633 \u0627\u0632 \u062a\u06a9\u0645\u06cc\u0644 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0648 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u062a\u0627\u067e \u0686\u0646\u062c \u0627\u0632 \u062a\u06a9\u0645\u06cc\u0644 \u067e\u0631\u0648\u0633\u0647 \u0645\u0628\u0644\u063a \u0627\u0632 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u06a9\u0633\u0631 \u0645\u06cc \xad\u0634\u0648\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u062a\u0648\u062c\u0647 \u0641\u0631\u0645\u0627\u06cc\u06cc\u062f \u06a9\u0647 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0633 \u0627\u0632 \u062b\u0628\u062a \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062f\u0631 \u062a\u0645\u0627\u0645\u06cc \u0645\u0631\u0627\u062d\u0644 \u0627\u0645\u06a9\u0627\u0646 \u0644\u063a\u0648 \u0646\u062f\u0627\u0631\u062f.",WAIT_FOR_PROCESS_WITHDRAW_BANK_PAYMENT_REQUEST2:"\u0644\u0637\u0641\u0627 \u067e\u0633 \u0627\u0632 \u062b\u0628\u062a \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062a\u0627 \u0632\u0645\u0627\u0646 \u0627\u0639\u0644\u0627\u0645 \u0634\u062f\u0647 (\u0639\u0635\u0631 \u0631\u0648\u0632 \u0622\u06cc\u0646\u062f\u0647 \xad\u06cc \u06a9\u0627\u0631\u06cc) \u0627\u0632 \u0645\u0631\u0627\u062c\u0639\u0647 \u0628\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0628\u0631\u0627\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0645\u0628\u0644\u063a \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u0646\u0645\u0627\u06cc\u06cc\u062f.",ONLINE_SUCCESS:"\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0648 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0634\u0627\u0631\u0698 \u0634\u062f.",MIN_ORDER:"\u062d\u062f\u0627\u0642\u0644 \u0645\u0628\u0644\u063a \u0628\u0627\u06cc\u062f {{value}} \u0628\u0627\u0634\u062f",MAX_ORDER:"\u062d\u062f\u0627\u06a9\u062b\u0631 \u0645\u0628\u0644\u063a \u0628\u0627\u06cc\u062f {{value}} \u0628\u0627\u0634\u062f",PAYMENT_ADD_SUCCESSFUL:"\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062b\u0628\u062a \u0634\u062f",CONFIRM_PAYMENT_DELETE:"\u0622\u06cc\u0627 \u0627\u0632 \u062d\u0630\u0641 \u0627\u06cc\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0627 \u0645\u0628\u0644\u063a {{value}} \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f \u061f",PAYMENT_DELETED_SUCCESS:"\u067e\u0631\u062f\u0627\u062e\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062d\u0630\u0641 \u06af\u0631\u062f\u06cc\u062f",CONFIRM_REQUEST_DELETE:"\u0622\u06cc\u0627 \u0627\u0632 \u062d\u0630\u0641 \u0627\u06cc\u0646 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u0637\u0645\u0626\u0646 \u0647\u0633\u062a\u06cc\u062f\u061f",REQUEST_DELETED_SUCCESS:"\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u062d\u0630\u0641 \u0634\u062f",CAN_SEND_MESSAGE:"\u0627\u0631\u0633\u0627\u0644 \u067e\u06cc\u0627\u0645 \u067e\u0633 \u0627\u0632 \u062b\u0628\u062a \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0641\u0639\u0627\u0644 \u0645\u06cc \u0634\u0648\u062f",THERE_IS_NO_MESSAG:"\u067e\u06cc\u0627\u0645\u06cc \u062c\u0647\u062a \u0646\u0645\u0627\u06cc\u0634 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f",COMMISION_DATA_NOT_FOUND:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0627\u0631\u0645\u0632\u062f \u06cc\u0627\u0641\u062a \u0646\u0634\u062f",COMMISSION_DATA_IS_NOT_DEFIENED:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0627\u0631\u0645\u0632\u062f \u062a\u0639\u0631\u06cc\u0641 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a",CURRENCY_LIST_IS_NOT_FOUND:"\u0644\u06cc\u0633\u062a \u0627\u0631\u0632\u0647\u0627 \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f",CURRENC
a\u06cc\u0631 \u0642\u0627\u0628\u0644 \u0645\u0630\u0627\u06a9\u0631\u0647 \u0627\u0633\u062a",SPECIFIED_TIME:"\u0644\u0637\u0641\u0627 \u0622\u0632\u0627\u062f \u0633\u0627\u0632\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u062a\u0639\u06cc\u06cc\u0646 \u0634\u062f\u0647 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u067e\u0627\u06cc\u0627\u0646 \u06cc\u0627\u0641\u062a\u0646 \u0627\u06cc\u0646 \u0632\u0645\u0627\u0646 \u060c \u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u0628\u0647 \u062e\u0631\u06cc\u062f\u0627\u0631\u0648 \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u067e\u0627\u0633\u062e\u06af\u0648 \u0628\u0627\u0634\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0639\u062f\u0645 \u067e\u0627\u0633\u062e\u06af\u0648\u06cc\u06cc\u060c\u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u062c\u0627\u0632 \u0628\u0647 \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0645\u0628\u0644\u063a \u0622\u06af\u0647\u06cc \u0645\u06cc\u0628\u0627\u0634\u062f",CONTROLLED_ASSETS_PLATFORM:"\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0645\u0633\u062a\u0642\u06cc\u0645\u0627 \u0628\u0647 \u062d\u0633\u0627\u0628 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0645\u06cc\u0631\u0648\u062f \u0648 \u0641\u0642\u0637 \u062f\u0627\u0631\u0627\u06cc\u06cc \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u06cc \u06a9\u0647 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u062f\u0631 \u062d\u06cc\u0646 \u0645\u0639\u0627\u0645\u0644\u0647 \u0645\u06cc\u062e\u0648\u0627\u0647\u062f \u0628\u0641\u0631\u0648\u0634\u062f \u062a\u0648\u0633\u0637 \u067e\u0644\u062a\u0641\u0631\u0645 \u06a9\u0646\u062a\u0631\u0644 \u0645\u06cc\u0634\u0648\u062f.",DIPOSIT_FROM_ACCOUNT:"*** \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u062d\u062a\u0645\u0627 \u0648 \u0627\u06a9\u06cc\u062f\u0627 \u0627\u0632 \u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u062e\u0648\u062f \u067e\u0648\u0644 \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0647\u0631\u06af\u0648\u0646\u0647 \u0645\u063a\u0627\u06cc\u0631\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc\u060c \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0627\u0631\u0632 \u062e\u0648\u062f \u0631\u0627 \u0622\u0632\u0627\u062f \u0646\u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f \u0648 \u0647\u06cc\u0686 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631\u0628\u0631\u0627\u0628\u0631 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0646 \u0648\u062c\u0647 \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0634\u0645\u0627 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a",DIPOSIT_FROM_ACCOUNT2:"\u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0645\u0628\u0644\u063a \u062f\u0631\u06cc\u0627\u0641\u062a\u06cc \u0628\u0627\u06cc\u062f \u0627\u0632 \u0647\u0645\u0627\u0646 \u062d\u0633\u0627\u0628 \u0630\u06a9\u0631 \u0634\u062f\u0647 \u062f\u0631 \u0641\u0631\u0645 \u067e\u0631\u062f\u0627\u062e\u062a \u0648\u0627\u0631\u06cc\u0632 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f . \u062f\u0631 \u0635\u0648\u0631\u062a \u0645\u063a\u0627\u06cc\u06cc\u0631\u062a \u0628\u0647 \u0647\u06cc\u0686 \u0639\u0646\u0648\u0627\u0646 \u0622\u0632\u0627\u062f \u0633\u0627\u0632\u06cc \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u0646\u062f\u0647\u06cc\u062f \u0648 \u0628\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u0647\u06cc\u062f . \u062f\u0631 \u0635\u0648\u0631\u062a \u0622\u0632\u0627\u062f \u0633\u0627\u0632\u06cc \u067e\u0644\u062a\u0641\u0631\u0645 \u0647\u06cc\u062c\u06af\u0648\u0646\u0647 \u0645\u0633\u0639\u0648\u0644\u06cc\u062a\u06cc \u062f\u0631 \u0642\u0628\u0627\u0644 \u0645\u0628\u0644\u063a \u0622\u0632\u0627\u062f \u0634\u062f\u0647 \u0646\u062f\u0627\u0631\u062f",OVERPAY_CARE:"\u062f\u0631\u0635\u0648\u0631\u062a \u0645\u063a\u0627\u06cc\u06cc\u0631\u062a \u0645\u0628\u0644\u063a \u062f\u0631\u06cc\u0627\u0641\u062a\u06cc \u0628\u0627\u0641\u0631\u0645 \u067e\u0631\u062f\u0627\u062e\u062a \u060c\u0628\u0647 \u0647\u06cc\u0686 \u0639\u0646\u0648\u0627\u0646 \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0631\u0627\u0627\u0646\u062c\u0627\u0645 \u0646\u062f\u0647\u06cc\u062f \u0648 \u0628\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u0631\u0627\u062c\u0639\u0647 \u0628\u0641\u0631\u0645\u0627\u06cc\u06cc\u062f",PRESS_WITHOUT_PAYING:"\u0627\u06af\u0631 \u0628\u062f\u0648\u0646 \u0627\u06cc\u0646\u06a9\u0647 \u067e\u0631\u062f\u0627\u062e\u062a \u06a9\u0631\u062f\u0647 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0641\u0631\u0645 \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0648 \u0628\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u063a\u06cc\u0631 \u0648\u0627\u0642\u0639\u06cc \u067e\u0631 \u06a9\u0631\u062f\u0647 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0631\u0648\u06cc \u062f\u06a9\u0645\u0647 \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f \u0628\u0632\u0646\u06cc\u062f\u060c \u062f\u0633\u062a\u0631\u0633\u06cc \u0634\u0645\u0627 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0628\u0633\u062a\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f \u0648 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u062f\u0639\u0627\u06cc \u0647\u0631\u06af\u0648\u0646\u0647 \u062e\u0633\u0627\u0631\u062a \u0646\u0627\u0634\u06cc \u0627\u0632 \u0622\u0646 \u0631\u0627 \u0645\u062d\u0641\u0648\u0638 \u0645\u06cc \u062f\u0627\u0631\u062f",DOES_NOT_PAY_LIMITATION:"\u062f\u0631\u0635\u0648\u0631\u062a\u06cc\u06a9\u0647 \u067e\u0633 \u0627\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u0628\u0644\u063a \u062f\u0631\u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u062e\u0648\u062f \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u0646\u062f\u0647\u06cc\u062f \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u06cc\u062a\u0648\u0627\u0646\u062f \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0631\u0627\u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f\u0647 \u0648\u062f\u0633\u062a\u0631\u0633\u06cc \u0634\u0645\u0627\u0628\u0647 \u0633\u0631\u0648\u06cc\u0633 \u067e\u06cc \u062a\u0648 \u067e\u06cc \u0631\u0627\u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0645\u0633\u062f\u0648\u062f \u06a9\u0646\u062f",DIGITAL_ASSETS_MENTION:"\u0644\u0637\u0641\u0627 \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u06cc \u062f\u0627\u0631\u0627\u06cc\u06cc \u0647\u0627\u06cc \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u062e\u0648\u062f \u062d\u06cc\u0646 \u062c\u0627 \u0628\u0647 \u062c\u0627\u06cc\u06cc \u0647\u0627\u06cc \u0628\u0627\u0646\u06a9\u06cc \u0627\u0634\u0627\u0631\u0647 \u0646\u06a9\u0646\u06cc\u062f . \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0631\u0647\u06af\u06cc\u0631\u06cc \u06af\u0631\u062f\u062f \u0648 \u06cc\u0627 \u0627\u06cc\u0646\u06a9\u0647 \u0628\u0627\u0646\u06a9 \u0645\u0628\u0644\u063a \u0634\u0645\u0627 \u0631\u0648 \u0628\u0644\u0648\u06a9\u0647 \u06a9\u0646\u062f.",AVAILABLE_UNFULFILLED:"\u0627\u06af\u0631 \u0633\u0641\u0627\u0631\u0634\u0627\u062a \u062a\u06a9\u0645\u06cc\u0644 \u0646\u0634\u062f\u0647 \u06cc\u0627 \u0627\u062e\u062a\u0644\u0627\u0641\u0627\u062a\u06cc \u0628\u0627 \u062e\u0631\u06cc\u062f\u0627\u0631 \u062f\u0627\u0631\u06cc\u062f\u060c \u0644\u0637\u0641\u0627\u064b \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u062f \u06a9\u0647 \u0647\u0645\u06cc\u0634\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u06cc\u0627 \u0627\u06cc\u0645\u06cc\u0644\u06cc \u06a9\u0647 \u062f\u0631 \u067e\u0644\u062a\u0641\u0631\u0645 \u062b\u0628\u062a \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0628\u0627\u0634\u06cc\u062f.",THIRD_CHANNELS:"\u0634\u0645\u0627 \u0647\u06cc\u0686 \u0648\u0642\u062a \u0646\u0628\u0627\u06cc\u062f \u0628\u0627 \u0647\u06cc\u0686 \u0641\u0631\u0645 \u062c\u0627 \u0628\u0647 \u062c\u0627\u06cc\u06cc \u067e\u0648\u0644 \u06a9\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u06a9\u0627\u0646\u0627\u0644 \u062b\u0627\u0644\u062b\u06cc \u0647\u0645\u0686\u0648\u0646 \u0634\u0628\u06a9\u0647 \u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0648 \u06cc\u0627 \u067e\u06cc\u0627\u0645\u0631\u0633\u0627\u0646 \u0647\u0627 \u0648 \u06cc\u0627 \u0645\u0639\u0627\u0645\u0644\u0647 \u06cc \u0631\u0648\u062f\u0631 \u0631\u0648 \u060c \u0645\u0639\u0627\u0645\u0644\u0647 \u0627\u06cc \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f. \u067e\u0644\u062a\u0641\u0631\u0645 \u0646\u0645\u06cc\u062a\u0648\u0627\u0646\u062f \u0645\u0633\u0626\u0648\u0644 \u062e\u0633\u0627\u0631\u062a \u0648 \u06cc\u0627 \u0636\u0631\u0631\u06cc \u0628\u0627\u0634\u062f \u06a9\u0647 \u062e\u0627\u0631\u062c \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u067e\u0644\u062a\u0641\u0631\u0645 \u062f\u0631 \u0647\u06cc\u0686 \u0628\u062e\u0634\u06cc \u0627\u0632 \u062c\u0627\u0628\u0647\u200c\u062c\u0627\u06cc\u06cc P2P \u062f\u062e\u0627\u0644\u062a\u06cc \u0646\u062f\u0627\u0631\u062f.",COMMITMENT_LATER:"\u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0627\u06cc\u062f \u062f\u0631 \u0647\u0646\u06af\u0627\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645 \u0627\u0632 \u0628\u0647 \u06a9\u0627\u0631 \u0628\u0631\u062f\u0646 \u0627\u0644\u0641\u0627\u0638 \u0631\u06a9\u06cc\u06a9 \u0648 \u062a\u0648\u0647\u06cc\u0646 \u0622\u0645\u06cc\u0632 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u0646\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0645\u0634\u0627\u0647\u062f\u0647 \u0627\u06cc\u0646 \u0631\u0641\u062a\u0627\u0631 \u0628\u0627 \u0634\u0645\u0627 \u0628\u0631\u062e\u0648\u0631\u062f \u062e\u0648\u0627\u0647\u062f \u0634\u062f.",SHARE_ACCOUNT_WARNING:"\u062f\u0631 \u0647\u06cc\u0686 \u0635\u0648\u0631\u062a \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0641\u0631\u062f \u062f\u06cc\u06af\u0631\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u06a9\u0646\u06cc\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0633\u0627\u0628 \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0647\u06cc\u0686 \u0639\u0646\u0648\u0627\u0646 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0642\u0631\u0627\u0631 \u0646\u062f\u0647\u06cc\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u062f\u06cc\u062f\u0647 \u0634\u062f\u0646 \u0686\u0646\u06cc\u0646 \u0631\u0641\u062a\u0627\u0631\u06cc \u062d\u0633\u0627\u0628 \u0634\u0645\u0627 \u0645\u0633\u062f\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u0634\u062f \u0648 \u062f\u0631 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0628\u0647 \u067e\u0644\u06cc\u0633 \u0641\u062a\u0627 \u0627\u0637\u0644\u0627\u0639 \u062f\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.",AGENDA_VIOLATION:"\u062f\u0631 \u0635\u0648\u0631\u062a \u0647\u0631\u06af\u0648\u0646\u0647 \u0646\u0642\u0636 \xab\u062f\u0633\u062a\u0648\u0631\u0627\u0644\u0639\u0645\u0644\u200c\u0647\u0627\u06cc \u0641\u0631\u0648\u0634\u0646\u062f\u0647\xbb \u0627\u0639\u0644\u0627\u0645 \u0634\u062f\u0647\u060c \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0648 \u0645\u0642\u0631\u0631\u0627\u062a \u0645\u0631\u0628\u0648\u0637\u0647\u060c \u06cc\u0627 \u0628\u0646\u0627 \u0628\u0647 \u0635\u0644\u0627\u062d \u062f\u06cc\u062f \u062e\u0648\u062f\u060c \u0627\u0642\u062f\u0627\u0645\u0627\u062a\u06cc \u0631\u0627 \u06a9\u0647 \u0635\u0644\u0627\u062d \u0645\u06cc\u200c\u062f\u0627\u0646\u062f\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u06af\u0631\u0641\u062a\u0647 \u0634\u062f\u0646 \u0648\u062b\u06cc\u0642\u0647 \u060c \u0645\u0633\u062f\u0648\u062f \u06a9\u0631\u062f\u0646 \u062d\u0633\u0627\u0628 \u0645\u062a\u062e\u0644\u0641 \u06cc\u0627 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0647\u0631 \u06af\u0648\u0646\u0647 \u0639\u0645\u0644\u06a9\u0631\u062f \u062d\u0633\u0627\u0628 \u062f\u0631 \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u0639\u0627\u0645\u0644\u0627\u062a\u06cc \u0627\u062a\u062e\u0627\u0630 \u06a9\u0646\u062f.",THIRD_PARTY_PAYMENT_WARNING:"\u0641\u0642\u0637 \u0627\u0632 \u062d\u0633\u0627\u0628 \u0628\u0627\u0646\u06a9\u06cc \u0648 \u0631\u0648\u0634 \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0628\u0647 \u0646\u0627\u0645 \u062e\u0648\u062f\u062a\u0627\u0646 \u0648 \u0645\u0637\u0627\u0628\u0642 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a\u200c\u0634\u062f\u0647 \u0634\u0645\u0627 \u0628\u0627\u0634\u062f\u061b \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062e\u0635 \u062b\u0627\u0644\u062b \u0645\u062c\u0627\u0632 \u0646\u06cc\u0633\u062a.",ASSET_LOCK_WARNING:"\u067e\u0633 \u0627\u0632 \u0634\u0631\u0648\u0639 \u0645\u0639\u0627\u0645\u0644\u0647\u060c \u062f\u0627\u0631\u0627\u06cc\u06cc \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u062f\u0631 \u0627\u0645\u0627\u0646\u062a \u0642\u0641\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062a\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u06cc\u0627 \u0644\u063a\u0648 \u0633\u0641\u0627\u0631\u0634 \u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.",PAYMENT_DEADLINE_WARNING:"\u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0648\u0638\u0641 \u0627\u0633\u062a \u0645\u0628\u0644\u063a \u06a9\u0627\u0645\u0644 \u0633\u0641\u0627\u0631\u0634 \u0631\u0627 \u062f\u0631 \u0645\u0647\u0644\u062a \u062a\u0639\u06cc\u06cc\u0646\u200c\u0634\u062f\u0647 \u0648 \u0637\u0628\u0642 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0627\u0639\u0644\u0627\u0645\u200c\u0634\u062f\u0647 \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u062f.",FINAL_TRANSACTION_WARNING:"\u0645\u0639\u0627\u0645\u0644\u0627\u062a P2P \u0646\u0647\u0627\u06cc\u06cc \u0647\u0633\u062a\u0646\u062f\u061b \u0642\u0628\u0644 \u0627\u0632 \u062b\u0628\u062a \u0633\u0641\u0627\u0631\u0634\u060c \u0645\u0628\u0644\u063a\u060c \u0642\u06cc\u0645\u062a \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u0628\u0627 \u062f\u0642\u062a \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f.",BUYER_PAYMENT_DEADLINE:"\u062e\u0631\u06cc\u062f\u0627\u0631 \u0645\u0648\u0638\u0641 \u0627\u0633\u062a \u0645\u0628\u0644\u063a \u06a9\u0627\u0645\u0644 \u0633\u0641\u0627\u0631\u0634 \u0631\u0627 \u062f\u0631 \u0645\u0647\u0644\u062a \u062a\u0639\u06cc\u06cc\u0646\u200c\u0634\u062f\u0647 \u0648 \u0637\u0628\u0642 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0627\u0639\u0644\u0627\u0645\u200c\u0634\u062f\u0647 \u0648\u0627\u0631\u06cc\u0632 \u06a9\u0646\u062f.",RELEASE_DEADLINE_WARNING:"\u0644\u0637\u0641\u0627 \u0622\u0632\u0627\u062f \u0633\u0627\u0632\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u062a\u0639\u06cc\u06cc\u0646 \u0634\u062f\u0647 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f. \u062f\u0631 \u0635\u0648
,PENDING_REVIEW_PHONE_NUMBER:"\u0634\u0645\u0627\u0631\u0647 \u0634\u0645\u0627 \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0627\u0633\u062a \u0644\u0637\u0641\u0627 \u0635\u0628\u0648\u0631 \u0628\u0627\u0634\u06cc\u062f"},REJECTED:{TITLE:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0646\u0627\u0645\u0648\u0641\u0642",MESSAGE_TEXT:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc\u066c \u0645\u062a\u0627\u0633\u0641\u0627\u0646\u0647 \u0645\u0634\u06a9\u0644\u0627\u062a\u06cc \u062f\u0631 \u0631\u0648\u0646\u062f \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u067e\u06cc\u062f\u0627 \u0634\u062f\u0647\u060c \u0644\u0637\u0641\u0627 \u0628\u0631\u0627\u06cc \u0627\u062f\u0627\u0645\u0647 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f.",CONTACT_SUPPORT:"\u062a\u0645\u0627\u0633 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc"}},COMMITMENT_CONFIRMATION:{CONFIRMATION_OF_THE_COMMITMENT_LETTER:"\u062a\u0627\u06cc\u06cc\u062f \u062a\u0639\u0647\u062f\u0646\u0627\u0645\u0647",SUB_TEXT_CONFIRMATION_OF_THE_COMMITMENT_LETTER:"\u0628\u0631\u0627\u06cc \u062a\u06a9\u0645\u06cc\u0644 \u0641\u0631\u0627\u06cc\u0646\u062f \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a\u060c \u0644\u0637\u0641\u0627\u064b \u062a\u0639\u0647\u062f\u0646\u0627\u0645\u0647 \u0631\u0627 \u062a\u0623\u06cc\u06cc\u062f \u0646\u0645\u0627\u06cc\u06cc\u062f.",TEXT_CONFIRM_COMMITMENT_LETTER:" \u0627\u06cc\u0646\u062c\u0627\u0646\u0628 {{name}} \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 \u0645\u0644\u06cc {{nationalIdentityNumber}} \u0645\u062f\u0627\u0631\u06a9 \u062e\u0648\u062f \u0631\u0627 \u062c\u0647\u062a \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u062f\u0631 \u0633\u0627\u06cc\u062a (TopChange) \u0627\u0631\u0633\u0627\u0644 \u06a9\u0631\u062f\u0647\u200c\u0627\u0645 \u0648 \u0628\u0627 \u0622\u06af\u0627\u0647\u06cc \u06a9\u0627\u0645\u0644 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0631\u0627 \u062a\u0623\u06cc\u06cc\u062f \u0645\u06cc\u200c\u06a9\u0646\u0645:",CONFIRM:"\u062a\u0627\u06cc\u06cc\u062f",ITEM_COMMITMENT_LETTER:{TITLE_ONE:"\u062a\u0623\u06cc\u06cc\u062f \u0647\u0648\u06cc\u062a \u0634\u062e\u0635\u06cc",DESC_ONE:"\u062b\u0628\u062a\u200c\u0646\u0627\u0645 \u0648 \u0627\u0631\u0633\u0627\u0644 \u0645\u062f\u0627\u0631\u06a9 \u062a\u0648\u0633\u0637 \u0634\u062e\u0635 \u0645\u0646 \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a \u0648 \u0645\u062f\u0627\u0631\u06a9 \u0647\u0648\u06cc\u062a\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0647\u06cc\u0686 \u0641\u0631\u062f \u062f\u06cc\u06af\u0631\u06cc \u0642\u0631\u0627\u0631 \u0646\u062f\u0627\u062f\u0647\u200c\u0627\u0645.",TITLE_TWO:"\u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc",DESC_TWO:"\u0645\u062a\u0639\u0647\u062f \u0645\u06cc\u200c\u0634\u0648\u0645 \u06a9\u0647 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0634\u062e\u0635\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u0645 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0627\u0646\u06a9\u06cc \u0648 \u0647\u0648\u06cc\u062a\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0647\u06cc\u0686 \u0641\u0631\u062f\u06cc \u0642\u0631\u0627\u0631 \u0646\u062f\u0647\u0645. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u0632 \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u0648\u0644 \u0646\u0642\u062f \u06cc\u0627 \u0627\u0631\u0632 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644 \u0628\u0647 \u0647\u0631 \u0634\u06a9\u0644\u06cc \u0627\u0632 \u0633\u0648\u06cc \u062f\u06cc\u06af\u0631\u0627\u0646 \u062f\u0631 \u0627\u0632\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc\u200c\u0627\u0645 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u062e\u0648\u0627\u0647\u0645 \u06a9\u0631\u062f.",TITLE_THREE:"\u067e\u0630\u06cc\u0631\u0634 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0642\u0627\u0646\u0648\u0646\u06cc",DESC_THREE:"\u062f\u0631 \u0635\u0648\u0631\u062a \u0628\u0631\u0648\u0632 \u0647\u0631\u06af\u0648\u0646\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u063a\u06cc\u0631\u0645\u062c\u0627\u0632 \u0627\u0632 \u062d\u0633\u0627\u0628\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0633\u067e\u0631\u062f\u0647\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0642\u0627\u0646\u0648\u0646\u06cc\u060c \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u06a9\u0627\u0645\u0644 \u0622\u0646 \u0631\u0627 \u0645\u06cc\u200c\u067e\u0630\u06cc\u0631\u0645 \u0648 \u062f\u0631 \u0635\u0648\u0631\u062a \u0628\u0631\u0648\u0632 \u062a\u062e\u0644\u0641\u060c \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0642\u0627\u0646\u0648\u0646\u06cc \u0648 \u0642\u0636\u0627\u06cc\u06cc \u0622\u0646\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u0645\u062c\u0627\u0632\u0627\u062a\u200c\u0647\u0627\u06cc \u0645\u0642\u0631\u0631 \u0648 \u062c\u0628\u0631\u0627\u0646 \u062e\u0633\u0627\u0631\u062a \u0634\u0627\u06a9\u06cc\u060c \u0628\u0631 \u0639\u0647\u062f\u0647 \u0627\u06cc\u0646\u062c\u0627\u0646\u0628 \u0627\u0633\u062a."}},DIALOG_AUTH_SUCCESS:{TITLE:"\u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0645\u0648\u0641\u0642",DESC:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u0645\u0631\u0627\u062d\u0644 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0648 \u0634\u0645\u0627 \u0645\u06cc\u062a\u0648\u0627\u064
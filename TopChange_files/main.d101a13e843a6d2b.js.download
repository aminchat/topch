u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629. \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0645\u0633\u062a\u0639\u062f\u064b\u0627\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 "\u0645\u062a\u0627\u0628\u0639\u0629" \u0644\u0628\u062f\u0621 \u0627\u0644\u0639\u0645\u0644\u064a\u0629.',START:"\u0627\u0628\u062f\u0623",CONTINUE:"\u0645\u062a\u0627\u0628\u0639\u0629",TITLE_PENDING_CHECK_KYC:"\u0645\u0631\u0627\u062c\u0639\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0647\u0648\u064a\u0629",DESC_PENDING_CHECK_KYC:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u0643 \u0628\u0646\u062c\u0627\u062d \u0648\u0647\u064a \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0645\u0646 \u0642\u0628\u0644 \u062e\u0628\u0631\u0627\u0626\u0646\u0627. \u0646\u0631\u062c\u0648 \u0645\u0646\u0643 \u0627\u0644\u062a\u062d\u0644\u064a \u0628\u0627\u0644\u0635\u0628\u0631.",LIST_INFO_FOR_KYC:{TITLE_PERSONAL_INFO:"\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629",DESC_PERSONAL_INFO:"\u064a\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 (\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644 \u0648\u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0626\u0644\u0629\u060c \u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f\u060c \u0627\u0644\u062c\u0646\u0633) \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0641\u0627\u0631\u0633\u064a\u0629 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0645\u0633\u062a\u0646\u062f \u0627\u0644\u0645\u0642\u062f\u0645.",TITLE_DOCUMENTS:"\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0647\u0648\u064a\u0629",DESC_DOCUMENTS:"\u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u062d\u062f \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a (\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629\u060c \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631\u060c \u0631\u062e\u0635\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629) \u0648\u062a\u062d\u0645\u064a\u0644 \u0635\u0648\u0631\u0629 \u0644\u0647. \u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u063a\u064a\u0631 \u0645\u0646\u062a\u0647\u064a \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0648\u0628\u062d\u0627\u0644\u0629 \u062c\u064a\u062f\u0629 \u0642\u0628\u0644 \u0625\u0631\u0633\u0627\u0644 \u0635\u0648\u0631\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062c\u0648\u062f\u0629.",TITLE_FACE_VERIFICATION:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0648\u062c\u0647",DESC_FACE_VERIFICATION:"\u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0628\u0635\u0631\u064a\u0629 \u0628\u0643\u0644 \u0628\u0633\u0627\u0637\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u062d\u0631\u064a\u0643 \u0627\u0644\u0631\u0623\u0633 \u0644\u0628\u0636\u0639 \u0644\u062d\u0638\u0627\u062a \u0623\u0645\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627."},PHONE_NUMBER_INFO_EDIT:{TILTE_IDENTITY_INFO_DOES_NOT_MATCH:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0647\u0648\u064a\u0629 \u0644\u0627 \u062a\u062a\u0637\u0627\u0628\u0642 \u0645\u0639 \u0635\u0627\u062d\u0628 \u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641.",DESC_IDENTITY_INFO_DOES_NOT_MATCH:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u0642\u062f\u0645\u062a\u0647\u0627 \u0644\u0627 \u062a\u0639\u0648\u062f \u0644\u0635\u0627\u062d\u0628 \u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0630\u064a \u0623\u062f\u062e\u0644\u062a\u0647. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0628\u0639\u062f \u0625\u062f\u062e\u0627\u0644 \u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u064a\u062e\u0635\u0643.",DOCUMENTS:"\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a",INFO_DOCUMENTS_UPLOADED:"\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u0642\u0645\u062a \u0628\u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u0647\u064a \u0643\u0627\u0644\u062a\u0627\u0644\u064a:",FULL_NAME:"\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644",DATE_OF_BIRTH:"\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f",NATIONAL_CODE:"\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a",PENDING_REVIEW_PHONE_NUMBER:"\u0631\u0642\u0645\u0643 \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0644\u064a \u0628\u0627\u0644\u0635\u0628\u0631"},REJECTED:{TITLE:"\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u0642\u0642",MESSAGE_TEXT:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u0644\u0623\u0633\u0641 \u062d\u062f\u062b\u062a \u0645\u0634\u0643\u0644\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u062f\u0639\u0645 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629.",CONTACT_SUPPORT:"\u0627\u062a\u0635\u0644 \u0628\u0627\u0644\u062f\u0639\u0645"}},COMMITMENT_CONFIRMATION:{CONFIRMATION_OF_THE_COMMITMENT_LETTER:"\u062a\u0623\u0643\u064a\u062f \u062e\u0637\u0627\u0628 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645",SUB_TEXT_CONFIRMATION_OF_THE_COMMITMENT_LETTER:"\u0644\u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629\u060c \u064a\u0631\u062c\u0649 \u062a\u0623\u0643\u064a\u062f \u062e\u0637\u0627\u0628 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645.",TEXT_CONFIRM_COMMITMENT_LETTER:"\u0623\u0646\u0627\u060c {{name}}\u060c \u0635\u0627\u062d\u0628 \u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 {{nationalIdentityNumber}}\u060c \u0642\u062f \u0642\u062f\u0645\u062a \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u064a \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 (TopChange) \u0648\u0623\u0642\u0631 \u0648\u0623\u0624\u0643\u062f \u062a\u0645\u0627\u0645\u064b\u0627 \u0645\u0627 \u064a\u0644\u064a:",CONFIRM:"\u062a\u0623\u0643\u064a\u062f",ITEM_COMMITMENT_LETTER:{TITLE_ONE:"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629",DESC_ONE:"\u062a\u0645 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0645\u0646 \u0642\u0628\u0644\u064a \u0634\u062e\u0635\u064a\u064b\u0627\u060c \u0648\u0644\u0645 \u0623\u0642\u0645 \u0628\u062a\u0633\u0644\u064a\u0645 \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u064a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0644\u0623\u064a \u0634\u062e\u0635 \u0622\u062e\u0631.",TITLE_TWO:"\u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u0633\u0627\u0628",DESC_TWO:"\u0623\u062a\u0639\u0647\u062f \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062d\u0633\u0627\u0628\u064a \u0628\u0634\u0643\u0644 \u0634\u062e\u0635\u064a \u0648\u0644\u0646 \u0623\u0634\u0627\u0631\u0643 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064a \u0627\u0644\u0628\u0646\u0643\u064a\u0629 \u0623\u0648 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0645\u0639 \u0623\u064a \u0634\u062e\u0635. \u0643\u0645\u0627 \u0623\u0646\u0646\u064a \u0623\u062a\u0639\u0647\u062f \u0628\u0639\u062f\u0645 \u0627\u0633\u062a\u0644\u0627\u0645 \u0623\u064a \u0645\u0628\u0627\u0644\u063a \u0646\u0642\u062f\u064a\u0629 \u0623\u0648 \u0639\u0645\u0644\u0627\u062a \u0631\u0642\u0645\u064a\u0629 \u0645\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646 \u0645\u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062d\u0633\u0627\u0628\u064a.",TITLE_THREE:"\u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0627\u062a \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629",DESC_THREE:"\u0641\u064a \u062d\u0627\u0644 \u062d\u062f\u0648\u062b \u0623\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u063a\u064a\u0631 \u0645\u0635\u0631\u062d \u0628\u0647 \u0644\u0644\u062d\u0633\u0627\u0628\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0633\u062a\u0644\u0627\u0645 \u0648\u062f\u0627\u0626\u0639 \u063a\u064a\u0631 \u0642\u0627\u0646\u0648\u0646\u064a\u0629\u060c \u0623\u062a\u062d\u0645\u0644 \u0643\u0627\u0645\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0627\u0644\u0642\u0636\u0627\u0626\u064a\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u0645\u0642\u0631\u0631\u0629 \u0648\u062a\u0639\u0648\u064a\u0636 \u0627\u0644\u0645\u062a\u0636\u0631\u0631."}},DIALOG_AUTH_SUCCESS:{TITLE:"\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0628\u0646\u062c\u0627\u062d",DESC:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u0642\u062f \u062a\u0645 \u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062
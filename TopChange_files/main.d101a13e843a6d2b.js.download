\u062e\u0648\u0627\u0646\u062f\u0645 \u0648 \u0628\u0627 \u0622\u0646 \u0645\u0648\u0627\u0641\u0642 \u0647\u0633\u062a\u0645.',TERMS_COMMITMENT_AGREEMENT:"\u0627\u06cc\u0646\u062c\u0627\u0646\u0628 {{value}} <a> \u0634\u0631\u0627\u06cc\u0637 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633 </a>\u0631\u0627 \u062e\u0648\u0627\u0646\u062f\u0645 \u0648 \u0628\u0627 \u0622\u0646 \u0645\u0648\u0627\u0641\u0642 \u0647\u0633\u062a\u0645.",DATE_DOT:"\u062a\u0627\u0631\u06cc\u062e:",TIME_DOT:"\u0632\u0645\u0627\u0646:",PAYMENT_TO_DOT:"\u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0647:",RECEIVER_PARAMETER_DOT:"\u06af\u06cc\u0631\u0646\u062f\u0647: <span>{{value}} (\u0641\u0631\u0648\u0634\u0646\u062f\u0647)</span>",PRICE_DOT:"\u0645\u0628\u0644\u063a:",CARD_NUMBER_DOT:"\u0634\u0645\u0627\u0631\u0647 \u06a9\u0627\u0631\u062a:",ACCOUNT_NUMBER_DOT:"\u0634\u0645\u0627\u0631\u0647 \u062d\u0633\u0627\u0628:",IBAN_NUMBER_DOT:"\u0634\u0645\u0627\u0631\u0647 \u0634\u0628\u0627:",BANK_TITLE_DOT:"\u0639\u0646\u0648\u0627\u0646 \u0628\u0627\u0646\u06a9:",ENTER_PAYMENT_INFORMATION:"\u0648\u0631\u0648\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a\u06cc \u0634\u0645\u0627",REMAINING_TIME_DOT:"\u0632\u0645\u0627\u0646 \u0628\u0627\u0642\u06cc\u0645\u0627\u0646\u062f\u0647:",ENTER_DEPOSIT_AMOUNT:"\u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0645\u0628\u0644\u063a \u0648\u0627\u0631\u06cc\u0632\u06cc",DEPOSIT_AMOUNT:"\u0645\u0628\u0644\u063a \u0648\u0627\u0631\u06cc\u0632\u06cc",ENTER_TRACKING_NUMBER:"\u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc",RECEIPT_IMAGE:"\u062a\u0635\u0648\u06cc\u0631 \u0631\u0633\u06cc\u062f(\u0627\u062c\u0628\u0627\u0631\u06cc)",UPLOAD_LIMIT_HINT:"\u06a9\u0645\u062a\u0631 \u0627\u0632 {{value}} MB",UPLOAD_LIMIT_ERROR:"\u062d\u062f\u0627\u06a9\u062b\u0631 \u062d\u062c\u0645 \u0641\u0627\u06cc\u0644: {{value}} \u0645\u06af\u0627\u0628\u0627\u06cc\u062a",UPLOAD_LIMIT_TYPE:"\u0641\u0627\u06cc\u0644 \u0647\u0627\u06cc \u0645\u062c\u0627\u0632: {{value}}",SUBMIT:"\u062b\u0628\u062a",DONE_NEXT:"\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u060c \u0628\u0639\u062f\u06cc",EXPECTATION:"\u0627\u0646\u062a\u0638\u0627\u0631!",PAYMENT_NOTIFIED:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0628\u0647 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0627\u0637\u0644\u0627\u0639 \u062f\u0627\u062f\u0647 \u0634\u062f.",AFTER_SELLER_CONFIRMED:"\u0628\u0639\u062f \u0627\u0632 \u062a\u0627\u06cc\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0627\u0632 \u0637\u0631\u0641 \u0641\u0631\u0648\u0634\u0646\u062f\u0647\u060c \u067e\u0648\u0644 \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0645\u0646\u062a\u0642\u0644 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.",WATING_SELLER_CONFIRMATION:"\u06a9\u0627\u0631\u0628\u0631 \u06af\u0631\u0627\u0645\u06cc\u060c \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0628\u0647 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u0627\u0637\u0644\u0627\u0639 \u062f\u0627\u062f\u0647 \u0634\u062f. \u0628\u0631\u0627\u06cc \u06af\u0641\u062a\u06af\u0648 \u0628\u0627 \u0641\u0631\u0648\u0634\u0646\u062f\u0647\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0622\u06cc\u06a9\u0648\u0646 \u0686\u062a \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u0648\u0627\u0631\u062f \u0686\u062a \u0627\u06cc\u0646 \u0633\u0641\u0627\u0631\u0634 \u0634\u0648\u06cc\u062f \u06cc\u0627 \u0628\u0647 \u0644\u06cc\u0633\u062a \u0633\u0641\u0627\u0631\u0634\u200c\u0647\u0627\u06cc \u0645\u0646 \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f. \u067e\u0633 \u0627\u0632 \u062a\u0627\u06cc\u06cc\u062f \u067e\u0631\u062f\u0627\u062e\u062a\u060c \u067e\u0648\u0644 \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0645\u0646\u062a\u0642\u0644 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.",NEED_TO_CONTACT_THE_SELLER:"\u0646\u06cc\u0627\u0632 \u0628\u0647 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0641\u0631\u0648\u0634\u0646\u062f\u0647 \u062f\u0627\u0631\u06cc\u062f\u061f",ENTER_THE_ORDER_CHAT:"\u0648\u0631\u0648\u062f \u0628\u0647 \u0686\u062a \u0633\u0641\u0627\u0631\u0634",REMAINING_AMOUNT:"\u0645\u0628\u0644\u063a \u0628\u0627\u0642\u06cc \u0645\u0627\u0646\u062f\u0647",MY_SALES_INFORMATION:"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062e\u0631\u06cc\u062f \u0645\u0646",DESIRED_CURRENCY_AMOUNT:"\u0645\u0642\u062f\u0627\u0631 \u0627\u0631\u0632 \u062f\u0644\u062e\u0648\u0627\u0647",VALUE_NOT_ALLOWED:"\u0645\u0642\u062f\u0627\u0631 \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u0645\u062c\u0627\u0632 \u0646\u0645\u06cc \u0628\u0627\u0634\u062f",MINIMUM_PURCHASE_PER_ORDER:"\u06a9\u0645\u062a\u0631\u06cc\u0646 \u062e\u0631\u06cc\u062f \u062f\u0631 \u0647\u0631 \u0633\u0641\u0627\u0631\u0634",AD_DURATION:"\u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u0646\u0645\u0627\u06cc\u0634 \u0622\u06af\u0647\u06cc",DAY:"\u0631\u0648\u0632",COMPUTING:"\u0645\u062d\u0627\u0633\u0628\u0647",TOTAL_REQUESTED_AMOUNT:"\u0645\u0642\u062f\u0627\u0631 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u06cc \u06a9\u0644",MINIMUM_ORDER_LIMIT:"\u06a9\u0645\u062a\u0631\u06cc\u0646 \u062d\u062f \u0633\u0641\u0627\u0631\u0634",EXCHANGE_RATES_TYPES:"\u0627\u0646\u0648\u0627\u0639 \u0646\u0631\u062e \u0627\u0631\u0632",FLOATING_CONVERSION_RATE:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u0634\u0646\u0627\u0648\u0631",FINAL_RATE_CONVERTION:"\u0646\u0631\u062e \u0646\u0647\u0627\u06cc\u06cc = \u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u0634\u0646\u0627\u0648\u0631 \u0628\u0627\u0632\u0627\u0631",USER_DETERMINES_SALES_RATE:"\u062a\u0639\u06cc\u06cc\u0646 \u0646\u0631\u062e \u0641\u0631\u0648\u0634 ( \u062a\u0628\u062f\u06cc\u0644) \u062a\u0648\u0633\u0637 \u06a9\u0627\u0631\u0628\u0631",FIXED_CONVERTION_RATE:"\u0646\u0631\u062e \u062a\u0628\u062f\u06cc\u0644 \u062b\u0627\u0628\u062a",ATTENTION:"\u062a\u0648\u062c\u0647",GUARANTEE_AMOUNT_COMPLY:"\u0645\u0628\u0644\u063a \u0648\u062b\u06cc\u0642\u0647 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0636\u0645\u0627\u0646\u062a \u06a9\u0627\u0631\u0628\u0631 \u0628\u0631\u0627\u06cc \u0631\u0639\u0627\u06cc\u062a \u0627\u0635\u0648\u0644 \u0648 \u0642\u0648\u0627\u0646\u06cc\u0646 P2P \u067e\u0644\u062a\u0641\u0631\u0645 \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a.\u0627\u06cc\u0646 \u0645\u0628\u0644\u063a \u0628\u0639\u062f \u0627\u0632 \u0628\u0633\u062a\u0647 \u0634\u062f\u0646 \u0622\u06af\u0647\u06cc\u060c \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0628\u0627\u0632 \u062e\u0648\u0627\u0647\u062f \u06af\u0634\u062a.",HIDDEN_AD_CASE:"\u0622\u06af\u0647\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 \u0627\u0632 \u062f\u06cc\u062f \u0639\u0645\u0648\u0645 \u067e\u0646\u0647\u0627\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f:",AD_TIME_OVER:"\u0627\u06af\u0631 \u0645\u062f\u062a \u0632\u0645\u0627\u0646 \u062a\u0639\u06cc\u06cc\u0646\u200c\u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u0646\u0645\u0627\u06cc\u0634 \u0622\u06af\u0647\u06cc\u060c \u062a\u0645\u0627\u0645 \u0634\u0648\u062f. \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u06af\u0647\u06cc \u0641\u0639\u0644\u06cc \u062e\u0648\u062f \u0631\u0627 \u062d\u0630\u0641 \u0648 \u0622\u06af\u0647\u06cc \u062c\u062f\u06cc\u062f\u06cc \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f.",AD_REMAIN_AMOUNT:"\u0645\u0628\u0644\u063a \u0628\u0627\u0642\u06cc\u200c\u0645\u0627\u0646\u062f\u0647 \u0627\u0632 \u0622\u06af\u0647\u06cc \u0634\u0645\u0627\u060c \u0627\u0632 \u0645\u0642\u062f\u0627\u0631 \xab\u06a9\u0645\u062a\u0631\u06cc\u0646 \u062e\u0631\u06cc\u062f \u062f\u0631 \u0647\u0631 \u0633\u0641\u0627\u0631\u0634\xbb \u067e\u0627\u06cc\u06cc\u0646\u200c\u062a\u0631 \u0628\u06cc\u0627\u06cc\u062f. \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0622\u06af\u0647\u06cc \u062e\u0648\u062f \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f. \u0645\u0628\u0644\u063a \u0628\u0627\u0642\u06cc\u200c\u0645\u0627\u0646\u062f\u0647 \u0628\u0647 \u06a9\u06cc\u0641 \u067e\u0648\u0644 \u0634\u0645\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06af\u0631\u062f\u062f.",ORDERS_FOR_SALE:"\u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u06f4 \u0633\u0641\u0627\u0631\u0634 \u0628\u0631\u0627\u06cc \u0622\u06af\u0647\u06cc \u0641\u0631\u0648\u0634 \u0634\u0645\u0627 \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u060c \u0622\u06af\u0647\u06cc \u0634\u0645\u0627 \u0628\u0647 \u0637\u0648\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u067e\u0646\u0647\u0627\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f.",SUPPORT_AGAINST_ORDERS:"\u0628\u0647 \u0645\u062d\u0636 \u0627\u06cc\u0646\u06a9\u0647 \u06f3 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0639\u0644\u06cc\u0647 \u0633\u0641\u0627\u0631\u0634\u0627\u062a \u062e\u0648\u062f \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0646\u06cc\u062f\u060c \u0647\u0645\u0647 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0634\u0645\u0627 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0648\u0642\u062a \u067e\u0646\u0647\u0627\u0646 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f.",RULES_VIOLATION_BAN:"\u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u062a\u062e\u0637\u06cc \u0627\u0632 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0645\u0634\u062e\u0635\u200c\u0634\u062f\u0647\u060c \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u0645\u0631\u0628\u0648\u0637\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0634\u0645\u0627 \u0631\u0
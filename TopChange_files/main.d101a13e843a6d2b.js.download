KE_PIC_DESCRIPTION:"\u0639\u0632\u064a\u0632\u064a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u0645\u0646\u0639 \u0623\u064a \u0627\u0646\u062a\u0647\u0627\u0643\u0627\u062a \u0648\u0636\u0645\u0627\u0646 \u0623\u0645\u0627\u0646 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062a\u060c \u064a\u0631\u062c\u0649 \u0625\u0631\u0633\u0627\u0644 \u0635\u0648\u0631\u062a\u0643 \u0628\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629:<br/>*\u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0643\u062a\u0648\u0628\u0629 \u0639\u0644\u0649 \u0648\u0631\u0642\u0629 \u0628\u064a\u0636\u0627\u0621 \u0628\u0634\u0643\u0644 \u062a\u0644\u0642\u0627\u0626\u064a.<br/>*\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062d\u062c\u0645 \u0627\u0644\u0635\u0648\u0631\u0629 \u0623\u0642\u0644 \u0645\u0646 2 \u0645\u064a\u062c\u0627\u0628\u0627\u064a\u062a.<br/> <div class='title'>1- \u0648\u0631\u0642\u0629 \u0628\u064a\u0636\u0627\u0621</div> \u0642\u0645 \u0628\u0623\u062e\u0630 \u0648\u0631\u0642\u0629 \u0628\u064a\u0636\u0627\u0621 \u0645\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u0623\u0645\u0627\u0645\u0643.<br/> <div class='title'>2- \u0625\u0631\u0641\u0627\u0642 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u0648\u064a\u0629</div> - \u0642\u0645 \u0628\u0625\u0631\u0641\u0627\u0642 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u0648\u064a\u0629 \u0628\u0627\u0644\u0648\u0631\u0642\u0629 \u0643\u0645\u0627 \u0647\u0648 \u0645\u0648\u0636\u062d \u0641\u064a \u0627\u0644\u0635\u0648\u0631\u0629.<br/> <div class='title'>3-\u0627\u0644\u0631\u0645\u0632</div>  \u0627\u0643\u062a\u0628 \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u0645\u0648\u0636\u062d \u0641\u064a \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0627\u0644\u064a \u0628\u062e\u0637 \u064a\u062f\u0643 \u0639\u0644\u0649 \u0627\u0644\u0648\u0631\u0642\u0629.<br/> <div class='title'>4- \u0627\u0644\u0646\u0635</div> \u0623\u0646\u0627 ............................ \u0628\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 ................. \u0642\u0645\u062a \u0628\u0625\u0631\u0633\u0627\u0644 \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u064a \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0647\u0648\u064a\u062a\u064a \u0641\u064a \u0645\u0648\u0642\u0639 TopChange \u0641\u064a ../../.. . \u0623\u0624\u0643\u062f \u0623\u0646\u0646\u064a \u0644\u0645 \u0623\u0642\u062f\u0645 \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0644\u0623\u064a \u0634\u062e\u0635 \u0622\u062e\u0631\u060c \u0648\u0623\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0639\u062f\u0645 \u0634\u0631\u0627\u0621 \u0623\u0648 \u0628\u064a\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0623\u0648 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0644\u0623\u064a \u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629. \u0623\u0641\u0647\u0645 \u0648\u0623\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0623\u062a\u064a \u0645\u0639 \u0645\u0634\u0627\u0631\u0643\u062a\u064a \u0641\u064a \u0643\u0644\u0627 \u0627\u0644\u0645\u0648\u0642\u0639\u064a\u0646 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u064a\u0646<br/> <div class='title'>5-\u0627\u0644\u062a\u0648\u0642\u064a\u0639</div>  \u062a\u0648\u0642\u064a\u0639\u0643.",TITLE:"\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a",UPLOAD_DRIVING_PHOTO:"\u0627\u062e\u062a\u0631 \u0635\u0648\u0631\u0629 \u0631\u062e\u0635\u0629 \u0627\u0644\u0642\u064a\u0627\u062f\u0629",UPL
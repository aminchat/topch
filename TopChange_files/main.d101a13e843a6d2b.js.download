ge here...",CONFIRM_AND_START_CHAT:"Confirm and Start Chat",THIS_CONVERSATION_HAS_ENDED:"This conversation has ended.",SHOW_ALL:"Show All",SHOW_LESS:"Show less",CHAT_WITH_SELLER:"Chat with seller",CHAT_WITH_BUYER:"Chat with buyer",GROUP_YESTERDAY:"Yesterday",GROUP_TODAY:"Today",RULES:{RULE_ONE:{TITLE:"Identity Verification",TEXT_ONE:"You confirm that you have accurately identified your role as either buyer or seller.",TEXT_TWO:"Any use of false identity, misrepresentation, or attempts to deceive the other party are prohibited."},RULE_TWO:{TITLE:"Security and Confidentiality",TEXT_ONE:"Avoid sharing sensitive, confidential, or personal information in conversations that could be misused.",TEXT_TWO:"You are responsible for protecting your own information."},RULE_THREE:{TITLE:"Responsible and Legal Behavior",TEXT_ONE:"Any threats, insults, illegal demands, requests contrary to the laws of the country, or unprofessional conduct are prohibited.",TEXT_TWO:"Financial or transactional agreements must be clear, traceable, and compliant with the law."},RULE_FOUR:{TITLE:"Avoid Transferring Funds Outside Secure Framework",TEXT_ONE:"Do not transfer any funds until the terms of the transaction are finalized and clear.",TEXT_TWO:"If necessary, only use secure methods introduced by the platform."},RULE_FIVE:{TITLE:"Transparency in Transactions",TEXT_ONE:"The seller must clearly state the details of the goods or services, final price, delivery conditions, and any potential issues.",TEXT_TWO:"The buyer must clearly communicate their conditions, expectations, and needs."},RULE_SIX:{TITLE:"Support Team Intervention",TEXT_ONE:"The support team has the right to enter the conversation at any time without prior notice.",TEXT_TWO:"If suspicious behavior, rule violations, or requests from either party are observed, support may review, limit, or terminate the conversation."},INTERNAL_CHAT_ONLY:"All transaction-related communications must be conducted exclusively through the platform's internal chat.",EXTERNAL_CHANNEL_FORBIDDEN:"Transferring conversations to any channel outside the platform is prohibited and will not be considered valid in dispute resolution.",CONTACT_SHARING_FORBIDDEN:"Sharing contact numbers, social media IDs, or transferring conversations outside the platform is strictly prohibited.",UNPROFESSIONAL_MESSAGE_WARNING:"Avoid sending unprofessional or non-standard messages, or requesting changes to the terms of the transaction.",DISPUTE_EVIDENCE_POLICY:"In the event of a dispute, only documents and information recorded in the platform's internal chat will serve as the basis for review and decision-making."},REPORT_VIOLATION:"Report",CONVERSATION_BLOCKED:"The conversation has been blocked.",THIS_CONVERSATION_HAS_BEEN_CLOSED_BY_AN_ADMIN:"This conversation has been closed by the admin.",REPORT_OF_RULE_VIOLATION:"Report of rule violations",REPORT_OF_RULE_VIOLATION_TEXT:"If you observe any suspicious activity, please report the relevant user immediately. This action helps us take necessary measures effectively and quickly, ensuring the security and safety of the user environment. Your cooperation in this matter is highly valued.",CONFIRM:"Confirm",EDIT:"Edit",ENTER_THE_DESCRIPTION:"Enter description...",WE_ARE_REVIEWING_YOUR_REPORT:"Your report has already been received and is currently under review.",REPORT_OF_RULE_VIOLATION_WARN:"Report of Rule Violation",REPORT_OF_RULE_VIOLATION_WARN_TEXT:"Your behavior or content has not complied with some of the platform's rules and standards. This report may have been filed for reasons such as violation of safety guidelines, inappropriate communications, or unauthorized activities. Please review the rules and adhere to them in future interactions to prevent this situation from recurring.",CONFIRM_AND_CONTINUE_CHAT:"Confirm and continue chat",REASON_REPORT:{offPlatform:"Off-platform transaction",shareContact:"Sharing contact info",abuse:"Offensive language",illegal:"Fraudulent activity",spam:"Sending spam messages",threat:"Threats or extortion"},ALERTS:{TITLE_SUCCESSFULL_REPORT:"The report has been successfully submitted.",DESCRIPTION_SUCCESSFULL_REPORT:"Thank you for your action. Our specialists are reviewing your report."}}},ADV_BANNER:{ADV_BANNER_BANNER:"TC offer to you"},CRYPTO_DEPOSIT:{DIALOG_ALERT:{TITLE_CHANGE_ADDRESS:"Changing Tether deposit addresses",BIG_DESCRIPTION_CHANGE_ADDRESS:"Your Tether deposit addresses will change starting February 3rd.",TEXT_ONE:"From this date:",TEXT_TWO:"Only use the new addresses on this page.",TEXT_THREE:"Deposits to old addresses will be your personal responsibility.",GOT_IT:"Understood"},NOTIFY:{NOTIFICATION:{TITLE:{CRYPTO_DEPOSIT:"Received (wallet)"},BODY:{CRYPTO_DEPOSIT:'An amount of <span class="fa-number-dir">&rlm;{{0}} </span> on the <span>{{1}}</span> network with transaction ID <span>{{2}}</span> was received.'}}}},CRYPTO_WITHDRAW:{NOTIFY:{NOTIFICATION:{TITLE:{CRYPTO_WITHDRAW:"Withdrawal from Wallet"},BODY:{CRYPTO_WITHDRAW:'An amount of <span class="fa-number-dir">&rlm;{{0}} </span> was withdrawn on the <span>{{1}}</span> network with tracking number <span>{{2}}</span>.'}}}},APPLICATION_PWA:{TEXT:"Application TopChange",INSTALL:"Install",UPDATE_VERSION:"A new version is ready. Update now to get the latest changes.",UPDATE:"Update",ALERTS_PAGE:{UPDATE:"Update",NEED_UPDATE_TEXT:"To enhance your experience, we have introduced new features and made changes to the app's performance. We recommend updating your app.",FORCE_UPDATE_TEXT:"To maintain the security of your account and ensure uninterrupted access to services, please update your app to the latest version. This will only take a moment.",LATER:"Later",SERVICE_DISABLED_TITLE:"Service Discontinued",SERVICE_DISABLED_TEXT:"This version of the application has reached the end of its activity and is no longer supported. We sincerely thank you for your companionship during this time. If you have a remaining balance or any questions about your account, please contact support immediately.",EXIT_APP:"Exit App",DEVICE_IS_ROOTED_TITLE:"App Access Blocked",DEVICE_IS_ROOTED_TEXT:"In order to protect the security of your account and assets, running TopChange on rooted devices is not permitted."},BIOMETRIC:{TITLE:"TopChange",SUB_TITLE:"Verify your identity to sign in",CANCEL:"Cancel",SAVE_TITLE:"Save Password",SAVE_DESC:"Save your password for faster login next time.",SAVE_CONFIRM:"Save",SAVE_CANCEL:"No, thanks"}},DASHBOARD_NEW:{KYC_VERIFICATION:{TEXT:"Please complete your authentication to access TC services and activate deposits, cryptocurrency purchases, and trading permissions.",AUTHENTICATION:"Authentication",CONTINUE:"Continue",ALERT_KYC_TITLE:"You can't use this feature",ALERT_KYC_TEXT:"To access TC services, please complete your authentication first."},ACTIVE_REQUEST:{TITLE_ACTIVE_REQUEST:"Active Requests",VIEW:"View",AMOUNT_AND_TYPE:"Type and Amount",CHANGE_STATUS_DATE:"Time of Status Change",YOU_HAVE_NO_ACTIVE_REQUESTS:"You have no active requests."},EXCHANGE_RATE:{TILTE_EXCHANGE_RATE:"Exchange Rate",BUY:"Buy:",SELL:"Sell:",NOT_FOUND_SEARCH:"No results were found for your search. Please try another currency name.",SEARCH:"Search"},DIALOG_MARATHON:{TITLE:"The profit marathon has begun!",DESC_ONE:'Join the competition by buying or selling <span class="bold">Tether</span> on <span class="en-number">P2P</span> and win prizes!',DESC_TWO:"You only have until June 17th!",COMPETITION_INFORMATION:"Competition Information",BUY_ADS:"Buy Advertisement"}},KYC_AUTH_NEW:{MOBILE_PHONE:"Mobile phone",IDENTITY_INFORMATION:"Identity information",COMMITMENT_LETTER:"Commitment Confirmation",AUTHENTICATION:"Authentication",TEXT_STEPPER:"Please complete the following steps to verify your authentication.",PHONE_STEP_DESC:"Please enter a mobile phone number that belongs to you.",COUNTRY:"Country",CONFIRM_CODE:"Confirm code",CHANGE_NUMBER:"Change number",DESCRIPTION_CONFIRM_PHONE_NUMBER_DIALOG:'Please enter the code sent to <strong class="dltr">{{value}}</stron